+// MAC UE with this E2SM gNB UE ID (AMF UE NGAP ID + GUAMI, as in the KPM
+// reports). Call with the scheduler lock held.
+static NR_UE_info_t* find_mac_ue(const ue_id_e2sm_t* ue_id)
+{
+  if (ue_id->type != GNB_UE_ID_E2SM)
+    return NULL;
+  const guami_t* guami = &ue_id->gnb.guami;
+  UE_iterator (RC.nrmac[0]->UE_info.connected_ue_list, ue) {
+    rrc_gNB_ue_context_t* rrc_ue = rrc_gNB_get_ue_context_by_rnti(RC.nrrrc[0], -1, ue->rnti);
+    if (rrc_ue == NULL)
+      continue;
+    const gNB_RRC_UE_t* u = &rrc_ue->ue_context;
+    if (u->amf_ue_ngap_id == ue_id->gnb.amf_ue_ngap_id && u->ue_guami.amf_region_id == guami->amf_region_id
+        && u->ue_guami.amf_set_id == guami->amf_set_id && u->ue_guami.amf_pointer == guami->amf_ptr)
+      return ue;
+  }
+  return NULL;
+}
+
+// S-NSSAI of a control message: SST (1 octet) and SD (3 octets, big endian);
+// false when the message has no SD
+static bool find_snssai(const e2sm_rc_ctrl_msg_frmt_1_t* msg, uint8_t* sst, uint32_t* sd)
+{
+  const ran_parameter_value_t* st = find_ran_param_value(msg->ran_param, msg->sz_ran_param, RC_PRB_QUOTA_SST);
+  const ran_parameter_value_t* d = find_ran_param_value(msg->ran_param, msg->sz_ran_param, RC_PRB_QUOTA_SD);
+  if (st == NULL || st->type != OCTET_STRING_RAN_PARAMETER_VALUE || st->octet_str_ran.len != 1 || d == NULL
+      || d->type != OCTET_STRING_RAN_PARAMETER_VALUE || d->octet_str_ran.len != 3)
+    return false;
+  *sst = st->octet_str_ran.buf[0];
+  *sd = (uint32_t)d->octet_str_ran.buf[0] << 16 | (uint32_t)d->octet_str_ran.buf[1] << 8 | d->octet_str_ran.buf[2];
+  return true;
+}
+
+// index of the RAN slice with this S-NSSAI, -1 if none. Call with the
+// scheduler lock held.
+static int find_e2_slice(const gNB_MAC_INST* mac, uint8_t sst, uint32_t sd)
+{
+  for (int i = 0; i < NR_E2_MAX_SLICES; i++)
+    if (mac->e2_slices[i].used && mac->e2_slices[i].sst == sst && mac->e2_slices[i].sd == sd)
+      return i;
+  return -1;
+}
+
+// Slice-level PRB quota with an S-NSSAI that has an SD: define (or change)
+// the RAN slice of that S-NSSAI, whose members share Max PRB Policy Ratio
+// percent of the BWP per slot; 100 removes the slice and its members go back
+// to the default slice
+static void ctrl_slice_quota(uint8_t sst, uint32_t sd, int ratio)
+{
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  int idx = find_e2_slice(mac, sst, sd);
+  if (ratio >= 100) {
+    if (idx >= 0) {
+      mac->e2_slices[idx].used = false;
+      UE_iterator (mac->UE_info.connected_ue_list, ue)
+        if (ue->UE_sched_ctrl.e2_slice == idx + 1)
+          ue->UE_sched_ctrl.e2_slice = 0;
+    }
+  } else {
+    for (int i = 0; i < NR_E2_MAX_SLICES && idx < 0; i++)
+      if (!mac->e2_slices[i].used)
+        idx = i;
+    if (idx >= 0)
+      mac->e2_slices[idx] = (nr_e2_slice_t){.used = true, .sst = sst, .sd = sd, .max_ratio = max(1, ratio)};
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (ratio < 100 && idx < 0)
+    printf("[E2 AGENT] RC CONTROL slice PRB quota: no free slot for SST %u SD %06x, ignored\n", sst, sd);
+  else
+    printf("[E2 AGENT] RC CONTROL slice PRB quota: SST %u SD %06x %s\n", sst, sd, ratio >= 100 ? "removed" : "set");
+  if (ratio < 100 && idx >= 0)
+    printf("[E2 AGENT] RC CONTROL slice PRB quota: slice %d Max PRB Policy Ratio %d%%\n", idx, ratio);
+}
+
+// Slice Handover: the UE in the header joins the RAN slice of the target
+// S-NSSAI (the default slice if none is defined for it)
+static void ctrl_slice_handover(const rc_ctrl_req_data_t* ctrl)
+{
+  uint8_t sst;
+  uint32_t sd;
+  if (!find_snssai(&ctrl->msg.frmt_1, &sst, &sd)) {
+    printf("[E2 AGENT] RC CONTROL slice handover: no target S-NSSAI (SST and SD), ignored\n");
+    return;
+  }
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  NR_UE_info_t* ue = find_mac_ue(&ctrl->hdr.frmt_1.ue_id);
+  const int idx = find_e2_slice(mac, sst, sd);
+  int rnti = -1;
+  if (ue != NULL) {
+    ue->UE_sched_ctrl.e2_slice = idx + 1;
+    rnti = ue->rnti;
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (rnti < 0)
+    printf("[E2 AGENT] RC CONTROL slice handover: no UE with AMF UE NGAP ID %lu, ignored\n", ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id);
+  else
+    printf("[E2 AGENT] RC CONTROL slice handover: UE %04x (AMF UE NGAP ID %lu) to SST %u SD %06x (%s)\n",
+           rnti,
+           ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id,
+           sst,
+           sd,
+           idx >= 0 ? "RAN slice" : "default slice");
+}
+
+// Style 2, Slice-level PRB quota. With an S-NSSAI that has an SD it sets the
+// PRB budget of that RAN slice (ctrl_slice_quota). Without one (the R2 use),
+// the quota applies to the UE named in the header: its Max PRB Policy Ratio
+// (percent of the BWP) bounds every new DL and UL allocation; 100 removes it.
+static void ctrl_prb_quota(const rc_ctrl_req_data_t* ctrl)
+{
+  const e2sm_rc_ctrl_msg_frmt_1_t* msg = &ctrl->msg.frmt_1;
+  const ran_parameter_value_t* max_ratio = find_ran_param_value(msg->ran_param, msg->sz_ran_param, RC_PRB_QUOTA_MAX_RATIO);
+  if (max_ratio == NULL || max_ratio->type != INTEGER_RAN_PARAMETER_VALUE || max_ratio->int_ran < 0 || max_ratio->int_ran > 100) {
+    printf("[E2 AGENT] RC CONTROL PRB quota: no valid Max PRB Policy Ratio (0..100), ignored\n");
+    return;
+  }
+  const int ratio = max_ratio->int_ran;
+  uint8_t sst;
+  uint32_t sd;
+  if (find_snssai(msg, &sst, &sd)) {
+    ctrl_slice_quota(sst, sd, ratio);
+    return;
+  }
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  NR_UE_info_t* ue = find_mac_ue(&ctrl->hdr.frmt_1.ue_id);
+  int rnti = -1;
+  if (ue != NULL) {
+    ue->UE_sched_ctrl.e2_max_prb_ratio = ratio >= 100 ? 0 : max(1, ratio);
+    rnti = ue->rnti;
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (rnti < 0)
+    printf("[E2 AGENT] RC CONTROL PRB quota: no UE with AMF UE NGAP ID %lu, ignored\n", ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id);
+  else
+    printf("[E2 AGENT] RC CONTROL PRB quota: UE %04x (AMF UE NGAP ID %lu) Max PRB Policy Ratio %d%%\n",
+           rnti,
+           ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id,
+           ratio);
+}
+
+// Style 4, RRC Connection Release: the same request the DU makes after a
+// radio link failure (F1 UE Context Release Request), so the CU asks the AMF
+// (NGAP UE Context Release Request) and releases the UE with RRCRelease
+static void ctrl_rrc_release(const rc_ctrl_req_data_t* ctrl)
+{
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  NR_UE_info_t* ue = find_mac_ue(&ctrl->hdr.frmt_1.ue_id);
+  const int rnti = ue != NULL ? ue->rnti : -1;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (rnti < 0) {
+    printf("[E2 AGENT] RC CONTROL RRC release: no UE with AMF UE NGAP ID %lu, ignored\n", ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id);
+    return;
+  }
+  const bool requested = nr_mac_request_release_ue(mac, rnti);
+  printf("[E2 AGENT] RC CONTROL RRC release: UE %04x (AMF UE NGAP ID %lu) %s\n",
+         rnti,
+         ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id,
+         requested ? "release requested" : "unknown to the CU, not released");
+}
