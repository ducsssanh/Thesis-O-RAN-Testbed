+static int ratio_rbs(int ratio, int bwp_size, int min_rbs)
+{
+  return min(bwp_size, max(min_rbs, (bwp_size * ratio + 50) / 100));
+}
+
+/* \brief largest allocation for a new transmission of this UE: the E2SM-RC
+ * PRB quota of the UE (percent of the BWP, at least min_rbs) and what is left
+ * in this slot of the budget of its E2 slice; below min_rbs the UE waits */
+int nr_mac_ue_max_rbs(const NR_UE_sched_ctrl_t *sched_ctrl, int bwp_size, int min_rbs, const nr_e2_slice_usage_t *usage)
+{
+  const int ratio = sched_ctrl->e2_max_prb_ratio;
+  int max_rbs = ratio == 0 || ratio >= 100 ? bwp_size : ratio_rbs(ratio, bwp_size, min_rbs);
+  const int s = sched_ctrl->e2_slice - 1;
+  if (s >= 0 && s < NR_E2_MAX_SLICES && RC.nrmac[0]->e2_slices[s].used) {
+    const int left = ratio_rbs(RC.nrmac[0]->e2_slices[s].max_ratio, bwp_size, min_rbs) - usage->used[s];
+    max_rbs = left < min_rbs ? 0 : min(max_rbs, left);
+  }
+  return max_rbs;
+}
+
+void nr_mac_slice_use(const NR_UE_sched_ctrl_t *sched_ctrl, int rbs, nr_e2_slice_usage_t *usage)
+{
+  const int s = sched_ctrl->e2_slice - 1;
+  if (s >= 0 && s < NR_E2_MAX_SLICES)
+    usage->used[s] += rbs;
+}
