+// KPM watchdog. Subscriptions are made once, to the E2 nodes connected at
+// startup; when the gNB restarts it reconnects to the RIC but this xApp keeps
+// a dead subscription and KPM stops silently. If no indication arrives for
+// KPM_STALE_S seconds the process exits, and Kubernetes restarts it to
+// subscribe again. KPM_STALE_S=0 disables the watchdog.
+static _Atomic int64_t last_kpm_us;
+
+static void* kpm_watchdog(void* arg) {
+  int64_t const stale_us = *(int64_t*)arg;
+  for (;;) {
+    sleep(1);
+    int64_t const idle = time_now_us() - atomic_load(&last_kpm_us);
+    if (idle > stale_us) {
+      fprintf(stderr, "[xApp] No KPM indication for %" PRId64 " s; exiting to resubscribe\n", idle / 1000000);
+      fflush(NULL);
+      _exit(3);
+    }
+  }
+  return NULL;
+}
+
+static void start_kpm_watchdog(void) {
+  static int64_t stale_us;
+  char const* env = getenv("KPM_STALE_S");
+  long const stale_s = env ? strtol(env, NULL, 10) : 10;
+  if (stale_s <= 0) {
+    printf("[xApp] KPM watchdog disabled\n");
+    return;
+  }
+  stale_us = (int64_t)stale_s * 1000000;
+  atomic_store(&last_kpm_us, time_now_us());
+  pthread_t t;
+  int const rc = pthread_create(&t, NULL, kpm_watchdog, &stale_us);
+  assert(rc == 0);
+  pthread_detach(t);
+  printf("[xApp] KPM watchdog: exit after %ld s without indications\n", stale_s);
+}
