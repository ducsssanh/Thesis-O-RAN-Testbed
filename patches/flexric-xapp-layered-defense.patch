+++ b/examples/xApp/c/monitor/classifier.c
@@ -0,0 +1,192 @@
+/* classifier layer of the defense (see defense_internal.h). The interface
+   is the window of feature vectors of one SUPI in, a label out:
+     v1 "rules"     the fair-use rule: rate above the SUPI's class while the
+                    cell is busy, in k of the last n samples
+     "external"     a model behind a loopback HTTP endpoint (sidecar):
+                    POST {"supi","since_seq","window":[vectors]} ->
+                    {"label":"benign|suspicious|attack|unknown","score","layer","kind","reason"};
+                    unknown, timeout or any failure falls back to v1 */
+#include "defense_internal.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <netinet/in.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+static unsigned long long calls, fallbacks, failures;
+static char last_error[96];
+
+const char *label_name(label_t l) {
+  return l == LABEL_BENIGN ? "benign" : l == LABEL_SUSPICIOUS ? "suspicious" : l == LABEL_ATTACK ? "attack" : "unknown";
+}
+
+static label_t label_of(const char *s) {
+  return strcmp(s, "benign") == 0 ? LABEL_BENIGN : strcmp(s, "suspicious") == 0 ? LABEL_SUSPICIOUS
+       : strcmp(s, "attack") == 0 ? LABEL_ATTACK : LABEL_UNKNOWN;
+}
+
+/* violation kind of one vector, NULL if none; *idle when above the class
+   while the cell was not busy */
+static const char *violation(const features_t *f, bool *idle) {
+  bool busy_ul = !cfg.congestion || (f->cell_ul >= cfg.cell_ul_prb_pct && f->others_ul > 0);
+  bool busy_dl = !cfg.congestion || (f->cell_dl >= cfg.cell_dl_prb_pct && f->others_dl > 0);
+  bool rate_ul = f->limit_ul > 0 && f->rate_ul >= f->limit_ul, rate_dl = f->limit_dl > 0 && f->rate_dl >= f->limit_dl;
+  bool over_ul = rate_ul || (cfg.ul_prb_pct > 0 && f->prb_ul >= cfg.ul_prb_pct);
+  bool over_dl = rate_dl || (cfg.dl_prb_pct > 0 && f->prb_dl >= cfg.dl_prb_pct);
+  *idle = false;
+  if (over_ul && busy_ul) return rate_ul ? "kpm_rate_ul" : "kpm_prb_ul";
+  if (over_dl && busy_dl) return rate_dl ? "kpm_rate_dl" : "kpm_prb_dl";
+  *idle = over_ul || over_dl;
+  return NULL;
+}
+
+/* v1: the newest vector violates and k of the last n undecided ones do */
+static void rules(const window_t *w, cls_result_t *out) {
+  *out = (cls_result_t){.label = LABEL_BENIGN, .layer = "ran", .source = "rules"};
+  if (w->n == 0) return;
+  bool idle;
+  const char *kind = violation(w->v[w->n - 1], &out->uncongested);
+  int hits = 0, seen = 0;
+  for (int i = w->n - 1; i >= 0 && seen < cfg.n; i--, seen++) {
+    if (w->v[i]->seq <= w->since_seq) break;
+    hits += violation(w->v[i], &idle) != NULL;
+  }
+  out->score = (double)hits / cfg.n;
+  if (!kind) return;
+  snprintf(out->kind, sizeof(out->kind), "%s", kind);
+  out->label = hits >= cfg.k ? LABEL_ATTACK : LABEL_SUSPICIOUS;
+  snprintf(out->reason, sizeof(out->reason), "%d of the last %d samples above class %s", hits, cfg.n, cfg.classes[w->v[w->n - 1]->cls].name);
+}
+
+/* minimal HTTP/1.0 POST to http://<IPv4>:<port><path>; returns the body */
+static char *post(const char *endpoint, const char *body, int timeout_ms, int *status) {
+  char host[64] = "";
+  int port = 80;
+  char path[96] = "/";
+  if (sscanf(endpoint, "http://%63[^:/]:%d%95s", host, &port, path) < 2) {
+    snprintf(last_error, sizeof(last_error), "bad endpoint %s", endpoint);
+    return NULL;
+  }
+  struct sockaddr_in a = {.sin_family = AF_INET, .sin_port = htons((uint16_t)port)};
+  if (inet_pton(AF_INET, host, &a.sin_addr) != 1) {
+    snprintf(last_error, sizeof(last_error), "endpoint host must be an IPv4 address");
+    return NULL;
+  }
+  int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0) return NULL;
+  struct timeval tv = {.tv_sec = timeout_ms / 1000, .tv_usec = timeout_ms % 1000 * 1000};
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+  char *resp = NULL;
+  if (connect(fd, (struct sockaddr *)&a, sizeof(a)) != 0) {
+    snprintf(last_error, sizeof(last_error), "connect: %s", strerror(errno));
+    goto out;
+  }
+  char head[256];
+  int hl = snprintf(head, sizeof(head), "POST %s HTTP/1.0\r\nHost: %s\r\nContent-Type: application/json\r\nContent-Length: %zu\r\n\r\n", path,
+                    host, strlen(body));
+  if (send(fd, head, (size_t)hl, MSG_NOSIGNAL) != hl || send(fd, body, strlen(body), MSG_NOSIGNAL) != (ssize_t)strlen(body)) {
+    snprintf(last_error, sizeof(last_error), "send: %s", strerror(errno));
+    goto out;
+  }
+  size_t cap = 4096, len = 0;
+  resp = malloc(cap);
+  for (;;) {
+    if (len + 1 >= cap) {
+      if (cap >= 65536) break;
+      resp = realloc(resp, cap *= 2);
+    }
+    ssize_t r = recv(fd, resp + len, cap - len - 1, 0);
+    if (r == 0) break;
+    if (r < 0) {
+      snprintf(last_error, sizeof(last_error), "recv: %s", errno == EAGAIN ? "timeout" : strerror(errno));
+      free(resp);
+      resp = NULL;
+      goto out;
+    }
+    len += (size_t)r;
+  }
+  resp[len] = '\0';
+  if (sscanf(resp, "HTTP/%*s %d", status) != 1) *status = 0;
+  char *b = strstr(resp, "\r\n\r\n");
+  if (!b) {
+    snprintf(last_error, sizeof(last_error), "no HTTP body");
+    free(resp);
+    resp = NULL;
+    goto out;
+  }
+  memmove(resp, b + 4, strlen(b + 4) + 1);
+out:
+  close(fd);
+  return resp;
+}
+
+/* 0: answered, 1: the model does not know, -1: failure (last_error) */
+static int external(const char *supi, const window_t *w, cls_result_t *out) {
+  json_object *req = json_object_new_object(), *arr = json_object_new_array();
+  json_object_object_add(req, "supi", json_object_new_string(supi));
+  json_object_object_add(req, "since_seq", json_object_new_uint64(w->since_seq));
+  for (int i = 0; i < w->n; i++) json_object_array_add(arr, features_json(w->v[i], supi));
+  json_object_object_add(req, "window", arr);
+  int status = 0;
+  char *body = post(cfg.endpoint, json_object_to_json_string_ext(req, JSON_C_TO_STRING_PLAIN), cfg.timeout_ms, &status);
+  json_object_put(req);
+  if (!body) return -1;
+  json_object *r = status == 200 ? json_tokener_parse(body) : NULL, *x = NULL;
+  if (status != 200) snprintf(last_error, sizeof(last_error), "HTTP %d", status);
+  free(body);
+  if (!r || !json_object_object_get_ex(r, "label", &x) || !json_object_is_type(x, json_type_string)) {
+    if (status == 200) snprintf(last_error, sizeof(last_error), "no label in the answer");
+    if (r) json_object_put(r);
+    return -1;
+  }
+  label_t l = label_of(json_object_get_string(x));
+  if (l != LABEL_UNKNOWN) {
+    out->label = l;
+    snprintf(out->source, sizeof(out->source), "external");
+    out->score = json_object_object_get_ex(r, "score", &x) ? json_object_get_double(x) : (l == LABEL_ATTACK ? 1.0 : 0.0);
+    if (json_object_object_get_ex(r, "layer", &x) && json_object_is_type(x, json_type_string))
+      snprintf(out->layer, sizeof(out->layer), "%s", json_object_get_string(x));
+    if (json_object_object_get_ex(r, "kind", &x) && json_object_is_type(x, json_type_string))
+      snprintf(out->kind, sizeof(out->kind), "%s", json_object_get_string(x));
+    else if (l == LABEL_ATTACK && !out->kind[0])
+      snprintf(out->kind, sizeof(out->kind), "model_attack");
+    if (json_object_object_get_ex(r, "reason", &x) && json_object_is_type(x, json_type_string))
+      snprintf(out->reason, sizeof(out->reason), "%s", json_object_get_string(x));
+  }
+  json_object_put(r);
+  return l == LABEL_UNKNOWN ? 1 : 0;
+}
+
+void classifier_classify(const char *supi, const window_t *w, cls_result_t *out) {
+  rules(w, out); /* always: the fallback, and the idle-cell count */
+  if (!cfg.external) return;
+  calls++;
+  cls_result_t ext = *out;
+  ext.kind[0] = ext.reason[0] = '\0';
+  int rc = external(supi, w, &ext);
+  if (rc == 0) {
+    ext.uncongested = out->uncongested;
+    *out = ext;
+    return;
+  }
+  failures += rc < 0;
+  fallbacks++;
+  snprintf(out->source, sizeof(out->source), "fallback");
+}
+
+json_object *classifier_state(void) {
+  json_object *o = json_object_new_object();
+  json_object_object_add(o, "kind", json_object_new_string(cfg.external ? "external" : "rules"));
+  json_object_object_add(o, "endpoint", json_object_new_string(cfg.endpoint));
+  json_object_object_add(o, "window", json_object_new_int(cfg.window));
+  json_object_object_add(o, "timeout_ms", json_object_new_int(cfg.timeout_ms));
+  json_object_object_add(o, "external_calls", json_object_new_uint64(calls));
+  json_object_object_add(o, "fallbacks", json_object_new_uint64(fallbacks));
+  json_object_object_add(o, "failures", json_object_new_uint64(failures));
+  json_object_object_add(o, "last_error", json_object_new_string(last_error));
+  return o;
+}
--- a/examples/xApp/c/monitor/policy.c
+++ b/examples/xApp/c/monitor/policy.c
@@ -0,0 +1,216 @@
+/* policy layer of the defense (see defense_internal.h): the RAN part of
+   the escalation (design 6) from the classifier's labels, independent of
+   which classifier produced them, and the reputation DB */
+#define _GNU_SOURCE /* strptime, timegm */
+#include "defense_internal.h"
+#include "../../../../src/util/time_now_us.h"
+#include <inttypes.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static uint64_t next_decision;
+
+static void save_reputation(const ue_t *u, int64_t now) {
+  if (!db) return;
+  sqlite3_stmt *q = NULL;
+  char exp[40], upd[40];
+  iso(u->expires_us, exp, sizeof(exp));
+  iso(now, upd, sizeof(upd));
+  if (sqlite3_prepare_v2(db, "INSERT INTO reputation(supi,level,score,expires_at,updated_at) VALUES(?,?,?,?,?) "
+                             "ON CONFLICT(supi) DO UPDATE SET level=excluded.level,score=excluded.score,"
+                             "expires_at=excluded.expires_at,updated_at=excluded.updated_at", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, u->supi, -1, SQLITE_TRANSIENT);
+    sqlite3_bind_int(q, 2, u->level);
+    sqlite3_bind_double(q, 3, u->score);
+    sqlite3_bind_text(q, 4, u->level ? exp : "", -1, SQLITE_TRANSIENT);
+    sqlite3_bind_text(q, 5, upd, -1, SQLITE_TRANSIENT);
+    sqlite3_step(q);
+  }
+  sqlite3_finalize(q);
+}
+
+static void save_evidence(const ue_t *u, int64_t now, double severity, double trust, const features_t *f, const cls_result_t *r) {
+  char ref[96], at[40];
+  snprintf(ref, sizeof(ref), "kpm:node=%s/ue=%" PRIu64 "/t=%" PRId64, f->node, f->amf, f->collect_us / 1000);
+  iso(now, at, sizeof(at));
+  if (db) {
+    sqlite3_stmt *q = NULL;
+    if (sqlite3_prepare_v2(db, "INSERT INTO evidence(supi,at,layer,kind,severity,ref,trust) VALUES(?,?,?,?,?,?,?)", -1, &q, NULL) == SQLITE_OK) {
+      sqlite3_bind_text(q, 1, u->supi, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 2, at, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 3, r->layer, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 4, r->kind, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_double(q, 5, severity);
+      sqlite3_bind_text(q, 6, ref, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_double(q, 7, trust);
+      sqlite3_step(q);
+    }
+    sqlite3_finalize(q);
+  }
+  json_object *o = event_base("evidence", u, now);
+  json_object_object_add(o, "kind", json_object_new_string(r->kind));
+  json_object_object_add(o, "layer", json_object_new_string(r->layer));
+  json_object_object_add(o, "label", json_object_new_string(label_name(r->label)));
+  json_object_object_add(o, "classifier", json_object_new_string(r->source));
+  json_object_object_add(o, "classifier_score", json_object_new_double(r->score));
+  json_object_object_add(o, "reason", json_object_new_string(r->reason));
+  json_object_object_add(o, "severity", json_object_new_double(severity));
+  json_object_object_add(o, "trust", json_object_new_double(trust));
+  json_object_object_add(o, "score", json_object_new_double(u->score));
+  json_object_object_add(o, "ref", json_object_new_string(ref));
+  json_object_object_add(o, "collect_ms", json_object_new_int64(f->collect_us / 1000));
+  json_object_object_add(o, "rate_ul_kbps", json_object_new_double(f->rate_ul));
+  json_object_object_add(o, "rate_dl_kbps", json_object_new_double(f->rate_dl));
+  json_object_object_add(o, "thp_ul_kbps", json_object_new_double(f->thp_ul));
+  json_object_object_add(o, "thp_dl_kbps", json_object_new_double(f->thp_dl));
+  json_object_object_add(o, "prb_ul_pct", json_object_new_double(f->prb_ul));
+  json_object_object_add(o, "prb_dl_pct", json_object_new_double(f->prb_dl));
+  json_object_object_add(o, "cell_prb_ul_pct", json_object_new_double(f->cell_ul));
+  json_object_object_add(o, "cell_prb_dl_pct", json_object_new_double(f->cell_dl));
+  json_object_object_add(o, "others_ul", json_object_new_int(f->others_ul));
+  json_object_object_add(o, "others_dl", json_object_new_int(f->others_dl));
+  json_object_object_add(o, "class", json_object_new_string(cfg.classes[u->cls].name));
+  event(o);
+}
+
+void policy_open_db(const char *path) {
+  if (!path || sqlite3_open(path, &db) != SQLITE_OK) {
+    fprintf(stderr, "[defense] cannot open %s: reputation not persisted\n", path ? path : "(null)");
+    if (db) sqlite3_close(db);
+    db = NULL;
+    return;
+  }
+  exec_sql("PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;"
+           "CREATE TABLE IF NOT EXISTS reputation(supi TEXT PRIMARY KEY,level INTEGER NOT NULL,score REAL NOT NULL,"
+           "expires_at TEXT NOT NULL,updated_at TEXT NOT NULL);"
+           "CREATE TABLE IF NOT EXISTS evidence(id INTEGER PRIMARY KEY,supi TEXT NOT NULL,at TEXT NOT NULL,layer TEXT NOT NULL,"
+           "kind TEXT NOT NULL,severity REAL NOT NULL,ref TEXT NOT NULL,trust REAL NOT NULL);"
+           "CREATE TABLE IF NOT EXISTS actions(id INTEGER PRIMARY KEY,supi TEXT NOT NULL,at TEXT NOT NULL,layer TEXT NOT NULL,"
+           "action TEXT NOT NULL,detail TEXT NOT NULL,status INTEGER NOT NULL,verified INTEGER NOT NULL);"
+           "CREATE TABLE IF NOT EXISTS e2_trust(e2_node TEXT PRIMARY KEY,kpm_trust REAL NOT NULL DEFAULT 1.0,"
+           "ctrl_trust REAL NOT NULL DEFAULT 1.0,last_mismatch TEXT,alarm INTEGER NOT NULL DEFAULT 0);"
+           "CREATE TABLE IF NOT EXISTS policy(supi TEXT PRIMARY KEY,class TEXT NOT NULL,updated_at TEXT NOT NULL);");
+}
+
+/* KPM trust of an E2 node (design 5.5; updated by the consistency check in
+   Phase L2, 1.0 until then) */
+static double kpm_trust(const char *node) {
+  double t = 1.0;
+  if (!db) return t;
+  sqlite3_stmt *q = NULL;
+  if (sqlite3_prepare_v2(db, "INSERT OR IGNORE INTO e2_trust(e2_node) VALUES(?)", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, node, -1, SQLITE_TRANSIENT);
+    sqlite3_step(q);
+  }
+  sqlite3_finalize(q);
+  if (sqlite3_prepare_v2(db, "SELECT kpm_trust FROM e2_trust WHERE e2_node=?", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, node, -1, SQLITE_TRANSIENT);
+    if (sqlite3_step(q) == SQLITE_ROW) t = sqlite3_column_double(q, 0);
+  }
+  sqlite3_finalize(q);
+  return t;
+}
+
+/* fair-use class of a SUPI: DB policy row, else config supiClass, else default */
+static int resolve_class(const char *supi) {
+  int cls = -1;
+  if (db) {
+    sqlite3_stmt *q = NULL;
+    if (sqlite3_prepare_v2(db, "SELECT class FROM policy WHERE supi=?", -1, &q, NULL) == SQLITE_OK) {
+      sqlite3_bind_text(q, 1, supi, -1, SQLITE_TRANSIENT);
+      if (sqlite3_step(q) == SQLITE_ROW) cls = class_index((const char *)sqlite3_column_text(q, 0));
+    }
+    sqlite3_finalize(q);
+  }
+  for (int i = 0; cls < 0 && i < cfg.n_assign; i++)
+    if (strcmp(cfg.assign[i].supi, supi) == 0) cls = cfg.assign[i].cls;
+  return cls < 0 ? 0 : cls;
+}
+
+ue_t *ue_for(const char *supi, bool create) {
+  ue_t *free_slot = NULL;
+  for (int i = 0; i < MAX_UES; i++) {
+    if (ues[i].used && strcmp(ues[i].supi, supi) == 0) return &ues[i];
+    if (!ues[i].used && !free_slot) free_slot = &ues[i];
+  }
+  if (!create || !free_slot) return NULL;
+  memset(free_slot, 0, sizeof(*free_slot));
+  free_slot->used = true;
+  snprintf(free_slot->supi, sizeof(free_slot->supi), "%s", supi);
+  free_slot->cls = resolve_class(supi);
+  return free_slot;
+}
+
+static void add_score(ue_t *u, int64_t now, double v) {
+  if (u->score_us && cfg.half_life_s > 0) u->score *= pow(0.5, (now - u->score_us) / 1e6 / cfg.half_life_s);
+  u->score += v;
+  u->score_us = now;
+}
+
+void policy_set_level(ue_t *u, int level, int64_t now, const char *why) {
+  int old = u->level;
+  u->level = level;
+  u->expires_us = level > 0 ? now + (int64_t)cfg.expiry_s[level > 2 ? 1 : level - 1] * 1000000 : 0;
+  save_reputation(u, now);
+  if (old != level) {
+    json_object *o = event_base("level", u, now);
+    json_object_object_add(o, "from", json_object_new_int(old));
+    json_object_object_add(o, "why", json_object_new_string(why));
+    event(o);
+    printf("[defense] %s level %d -> %d (%s)\n", u->supi, old, level, why);
+    fflush(stdout);
+  }
+}
+
+/* One classifier result: an attack label is evidence and moves the level
+   (a repeat within the probation -> 2; RAN evidence alone stops at 2,
+   design 6). Returns the decision ID, 0 when nothing was decided. */
+uint64_t policy_apply(ue_t *u, const features_t *f, const cls_result_t *r, int64_t now) {
+  if (r->uncongested) uncongested++; /* heavy use of an idle cell: not a violation */
+  if (r->label != LABEL_ATTACK) return 0;
+  double trust = kpm_trust(f->node);
+  bool repeat = u->level == 0 && now < u->probation_us;
+  double sev = cfg.sev_rate + (repeat ? cfg.sev_repeat : 0);
+  add_score(u, now, sev * trust);
+  u->decision_id = ++next_decision;
+  save_evidence(u, now, sev, trust, f, r);
+  u->since_seq = f->seq; /* later decisions use later samples only */
+  if (repeat) policy_set_level(u, 2, now, "repeat_offense");
+  else policy_set_level(u, u->level > 1 ? u->level : 1, now, r->kind);
+  return u->decision_id;
+}
+
+void policy_expire(int64_t now) {
+  for (int i = 0; i < MAX_UES; i++) {
+    ue_t *u = &ues[i];
+    if (!u->used || u->level == 0 || now < u->expires_us) continue;
+    if (u->level == 1) u->probation_us = now + (int64_t)cfg.probation_s * 1000000; /* quota lifted on probation */
+    policy_set_level(u, u->level - 1, now, "expired");
+  }
+}
+
+/* reputation survives an xApp restart: levels still in force come back and
+   their quotas are applied again when the SUPI is next seen */
+void policy_restore(void) {
+  if (!db) return;
+  sqlite3_stmt *q = NULL;
+  char now_iso[40];
+  iso(time_now_us(), now_iso, sizeof(now_iso));
+  if (sqlite3_prepare_v2(db, "SELECT supi,level,score,expires_at FROM reputation WHERE level>0 AND expires_at>?", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, now_iso, -1, SQLITE_TRANSIENT);
+    while (sqlite3_step(q) == SQLITE_ROW) {
+      ue_t *u = ue_for((const char *)sqlite3_column_text(q, 0), true);
+      if (!u) break;
+      u->level = sqlite3_column_int(q, 1);
+      u->score = sqlite3_column_double(q, 2);
+      u->score_us = time_now_us();
+      struct tm tm = {0};
+      if (strptime((const char *)sqlite3_column_text(q, 3), "%Y-%m-%dT%H:%M:%S", &tm))
+        u->expires_us = (int64_t)timegm(&tm) * 1000000;
+      printf("[defense] restored %s at level %d\n", u->supi, u->level);
+    }
+  }
+  sqlite3_finalize(q);
+}
--- a/examples/xApp/c/monitor/actuators.c
+++ b/examples/xApp/c/monitor/actuators.c
@@ -0,0 +1,123 @@
+/* actuators layer of the defense (see defense_internal.h): RAN actions that
+   bring the gNB in line with the levels, and the verifier of their effect */
+#include "defense_internal.h"
+#include "ran_control.h"
+#include <inttypes.h>
+#include <string.h>
+
+#define RETRY_US 2000000LL
+#define UE_GONE_US 10000000LL
+
+static sqlite3_int64 save_action(const ue_t *u, int64_t now, int ratio, uint64_t amf, int code, json_object *res) {
+  sqlite3_int64 id = 0;
+  char at[40], detail[64];
+  iso(now, at, sizeof(at));
+  snprintf(detail, sizeof(detail), "max_prb_ratio=%d ue=%" PRIu64, ratio, amf);
+  if (db) {
+    sqlite3_stmt *q = NULL;
+    if (sqlite3_prepare_v2(db, "INSERT INTO actions(supi,at,layer,action,detail,status,verified) VALUES(?,?,'ran',?,?,?,0)", -1, &q, NULL) == SQLITE_OK) {
+      sqlite3_bind_text(q, 1, u->supi, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 2, at, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 3, cfg.slice_mode ? "slice_handover" : "prb_quota", -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 4, detail, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_int(q, 5, code);
+      if (sqlite3_step(q) == SQLITE_DONE) id = sqlite3_last_insert_rowid(db);
+    }
+    sqlite3_finalize(q);
+  }
+  json_object *o = event_base("action", u, now);
+  json_object_object_add(o, "action", json_object_new_string(cfg.slice_mode ? "slice_handover" : "prb_quota"));
+  if (cfg.slice_mode) {
+    char sl[32];
+    snprintf(sl, sizeof(sl), "%d/%06" PRIx64, ratio < 100 ? cfg.q_sst : cfg.d_sst, ratio < 100 ? cfg.q_sd : cfg.d_sd);
+    json_object_object_add(o, "slice", json_object_new_string(sl));
+  }
+  json_object_object_add(o, "max_prb_ratio", json_object_new_int(ratio));
+  json_object_object_add(o, "amf_ue_ngap_id", json_object_new_uint64(amf));
+  json_object_object_add(o, "http", json_object_new_int(code));
+  if (res) json_object_object_add(o, "result", json_object_get(res));
+  event(o);
+  return id;
+}
+
+/* verifier: the limit in force for this UE ID holds when its PRB share obeys it */
+void actuators_verify(ue_t *u, const features_t *f, int64_t now) {
+  if (u->applied_ratio <= 0 || u->synced_amf != f->amf || u->verified) return;
+  if (f->prb_ul > u->applied_ratio + 3 || f->prb_dl > u->applied_ratio + 3) return;
+  u->verified = true;
+  if (db && u->last_action) {
+    char sql[96];
+    snprintf(sql, sizeof(sql), "UPDATE actions SET verified=1 WHERE id=%lld", (long long)u->last_action);
+    exec_sql(sql);
+  }
+  json_object *o = event_base("verified", u, now);
+  json_object_object_add(o, "collect_ms", json_object_new_int64(f->collect_us / 1000));
+  json_object_object_add(o, "prb_ul_pct", json_object_new_double(f->prb_ul));
+  json_object_object_add(o, "prb_dl_pct", json_object_new_double(f->prb_dl));
+  event(o);
+}
+
+/* Bring the gNB in line with the levels: limited while level >= 1, on the
+   UE ID the SUPI currently has (a re-attach gets it again) */
+void actuators_reconcile(int64_t now) {
+  for (int i = 0; i < MAX_UES; i++) {
+    pthread_mutex_lock(&st_lock);
+    ue_t *u = &ues[i];
+    if (!u->used || now < u->next_try_us) {
+      pthread_mutex_unlock(&st_lock);
+      continue;
+    }
+    bool present = u->amf && now - u->last_seen_us <= UE_GONE_US;
+    int want = u->level >= 1 && cfg.enabled ? cfg.max_prb_ratio : 0;
+    /* set the limit explicitly once per UE ID: one left by an earlier xApp
+       instance is unknown to this one */
+    bool needed = present && (u->synced_amf != u->amf || u->applied_ratio != want);
+    if (!needed) {
+      pthread_mutex_unlock(&st_lock);
+      continue;
+    }
+    char supi[96];
+    snprintf(supi, sizeof(supi), "%s", u->supi);
+    uint64_t amf = u->amf;
+    const bool slice = cfg.slice_mode;
+    pthread_mutex_unlock(&st_lock);
+
+    json_object *res = NULL;
+    int code;
+    if (!slice && want) {
+      code = ran_control_apply(supi, amf, true, "prb_quota", want, "defense", &res);
+    } else if (want) {
+      /* (re)define the quarantine slice first: a restarted gNB has none */
+      code = ran_control_slice(supi, amf, true, "prb_quota", cfg.q_sst, cfg.q_sd, want, "defense", &res);
+      if (code == 200) {
+        json_object_put(res);
+        res = NULL;
+        code = ran_control_slice(supi, amf, true, "slice_handover", cfg.q_sst, cfg.q_sd, -1, "defense", &res);
+      }
+    } else {
+      /* back to the default slice, and no UE quota left by an earlier
+         instance or the other mode */
+      code = ran_control_slice(supi, amf, true, "slice_handover", cfg.d_sst, cfg.d_sd, -1, "defense", &res);
+      if (code == 200) {
+        json_object_put(res);
+        res = NULL;
+        code = ran_control_apply(supi, amf, true, "prb_quota", 100, "defense", &res);
+      }
+    }
+
+    pthread_mutex_lock(&st_lock);
+    if (u->used && strcmp(u->supi, supi) == 0) {
+      if (code == 200) {
+        u->applied_ratio = want;
+        u->synced_amf = amf;
+        u->verified = false;
+      } else {
+        u->next_try_us = now + RETRY_US;
+      }
+      sqlite3_int64 id = save_action(u, now, want ? want : 100, amf, code, res);
+      if (want) u->last_action = id;
+    }
+    pthread_mutex_unlock(&st_lock);
+    json_object_put(res);
+  }
+}
