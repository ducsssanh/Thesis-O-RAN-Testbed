-static uldlcounter_t last_pdcp_sdu_total_bytes[MAX_MOBILES_PER_GNB] = {0};
+/* Previous cumulative counters of each UE, keyed by its RRC UE ID. They were
+   indexed by the position of the UE in the indication (ue_idx): when the UE
+   list changed (a UE leaving, a stale context expiring) a UE was subtracted
+   another UE's counters, giving wrapped or inflated deltas (found with two
+   UEs, plan R1). */
+typedef struct ue_counters {
+  bool used;
+  uint32_t rrc_ue_id;
+  uint64_t seen;
+  uldlcounter_t pdcp, rlc, prb;
+} ue_counters_t;
+
+static ue_counters_t ue_counters[MAX_MOBILES_PER_GNB];
+static uint64_t ue_counters_clock;
+
+static ue_counters_t *counters_of(uint32_t rrc_ue_id)
+{
+  ue_counters_t *free_slot = NULL, *oldest = &ue_counters[0];
+  for (size_t i = 0; i < MAX_MOBILES_PER_GNB; i++) {
+    ue_counters_t *c = &ue_counters[i];
+    if (c->used && c->rrc_ue_id == rrc_ue_id) {
+      c->seen = ++ue_counters_clock;
+      return c;
+    }
+    if (!c->used && free_slot == NULL)
+      free_slot = c;
+    if (c->seen < oldest->seen)
+      oldest = c;
+  }
+  // New UE (or one evicted as least recently reported): counters start at 0
+  ue_counters_t *c = free_slot != NULL ? free_slot : oldest;
+  memset(c, 0, sizeof(*c));
+  c->used = true;
+  c->rrc_ue_id = rrc_ue_id;
+  c->seen = ++ue_counters_clock;
+  return c;
+}
+
+/* Delta of a 32-bit cumulative counter: modular across a wrap, the new value
+   itself when the counter restarted (new context reusing the RRC UE ID) */
+static uint32_t counter_delta(uint32_t now, uint32_t *last)
+{
+  uint32_t d = now - *last;
+  if (now < *last && *last - now < (1u << 31))
+    d = now;
+  *last = now;
+  return d;
+}
 
