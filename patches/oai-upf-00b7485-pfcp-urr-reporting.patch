@@ -159,6 +160,18 @@ void UserPlaneComponent::Setup(
 
   Logger::upf_app().info("Session Manager initialized");
 
+  // PFCP encoding/sending belongs in userspace. Start consuming only after the
+  // BPF maps and the session registry are both available.
+  if (flags.enable_urr) {
+    const auto urr_program = upf_xdp_program_->GetUrrProgram();
+    if (!urr_program || !urr_program->GetUrrReportRingbuf()) {
+      throw std::runtime_error("URR enabled but report ring buffer is missing");
+    }
+    urr_report_consumer_ = std::make_shared<UrrReportConsumer>(
+        urr_program->GetUrrReportRingbuf(), session_manager_);
+    urr_report_consumer_->Start();
+  }
+
   // Count loaded features
   int feature_count = 3;  // Core: session_lookup + pdr_match + far
   if (flags.enable_qer) feature_count++;
@@ -211,6 +224,12 @@ void UserPlaneComponent::Setup(
 void UserPlaneComponent::TearDown() {
   Logger::upf_app().info("Tearing down User Plane Component");
 
+  // Stop polling while both the session registry and BPF map are still alive.
+  if (urr_report_consumer_) {
+    urr_report_consumer_->Stop();
+    urr_report_consumer_.reset();
+  }
+
   // Remove all sessions from singleton
   SessionProgramManager::GetInstance().RemoveAllSessions();
 
