+/**
+ * @brief Atomically claim a one-shot reporting trigger.
+ *
+ * Threshold and quota conditions remain true for every packet after they are
+ * crossed. Without this latch, each of those packets would enqueue another
+ * PFCP Usage Report event. Periodic reporting deliberately does not use it.
+ */
+static __always_inline bool urr_claim_one_shot_trigger(
+    struct urr_config* cfg, __u64 trigger) {
+  __u64 previous = __sync_fetch_and_or(&cfg->reported_triggers, trigger);
+  return !(previous & trigger);
+}
+
 /* ========================================================================== */
 /*                   THRESHOLD / QUOTA CHECK (§8.2.46-48)                     */
