 }
 
+//------------------------------------------------------------------------------
+bool smf_context::release_stale_pdu_session(const pdu_session_id_t& psi) {
+  std::shared_ptr<smf_pdu_session> sp = {};
+  if (!find_pdu_session(psi, sp)) return false;
+
+  // Already released (Release SM Context clears the session, keeping it in the
+  // list): no N4 session left in the UPF and resources already deallocated
+  if (sp->up_fseid.seid == 0) return remove_pdu_session(psi);
+
+  std::shared_ptr<upf_graph> graph = {};
+  if (sp->get_session_handler())
+    graph = sp->get_session_handler()->get_session_graph();
+
+  if (graph) {
+    // Same traversal as session_release_sm_context_procedure, but without an
+    // N11 transaction: the response is discarded (no matching procedure)
+    graph->start_asynch_dfs_procedure(false);
+    while (true) {
+      std::vector<std::shared_ptr<qos_upf_edge>> dl_edges;
+      std::vector<std::shared_ptr<qos_upf_edge>> ul_edges;
+      std::shared_ptr<pfcp_association> upf = {};
+      while (!graph->dfs_next_upf(dl_edges, ul_edges, upf))
+        ;
+      if (!upf) break;
+
+      auto n4 = std::make_shared<itti_n4_session_deletion_request>(
+          TASK_SMF_APP, TASK_SMF_N4);
+      n4->seid = sp->up_fseid.seid;
+      n4->trxn_id =
+          oai::utils::uint_uid_generator<uint64_t>::get_instance().get_uid();
+      n4->r_endpoint =
+          endpoint(upf->node_id.u1.ipv4_address, pfcp::default_port);
+      Logger::smf_app().info(
+          "Release stale PDU Session (SUPI %s, PDU Session ID %d): sending N4 "
+          "Session Deletion Request, UP SEID " SEID_FMT,
+          supi.c_str(), psi, n4->seid);
+      if (RETURNok != itti_inst->send_msg(n4)) {
+        Logger::smf_app().error(
+            "Could not send ITTI message %s to task TASK_SMF_N4",
+            n4->get_msg_name());
+      }
+    }
+    sp->deallocate_ressources(sp->get_dnn());
+  } else {
+    Logger::smf_app().warn(
+        "Stale PDU Session (Id %d) has no UPF graph, removing locally", psi);
+  }
+  return remove_pdu_session(psi);
+}
