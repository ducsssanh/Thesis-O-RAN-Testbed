+// KPM phase watchdog. KPM is subscribed on a second boundary so that its windows
+// line up with the UPF profile windows. A stall of the gNB can move the report
+// phase for good (seen 2026-11-02: 6.6 s stall, phase 401 ms, gate masked KPM for
+// 2 h with all bytes intact). If the phase stays more than KPM_PHASE_MAX_MS away
+// from the second for KPM_PHASE_HOLD_S seconds the process exits, and Kubernetes
+// restarts it to subscribe on the boundary again. KPM_PHASE_MAX_MS=0 disables it.
+static void kpm_phase_check(int64_t collect_ms) {
+  static int64_t max_ms = -1, hold_us, first_off_us;
+  if (max_ms < 0) {
+    char const* a = getenv("KPM_PHASE_MAX_MS");
+    char const* b = getenv("KPM_PHASE_HOLD_S");
+    max_ms = a ? strtol(a, NULL, 10) : 100;
+    hold_us = (b ? strtol(b, NULL, 10) : 5) * 1000000;
+  }
+  if (max_ms == 0) return;
+  int64_t phase = collect_ms % 1000;
+  if (phase > 500) phase -= 1000;
+  if (llabs(phase) <= max_ms) {
+    first_off_us = 0;
+    return;
+  }
+  int64_t const now = time_now_us();
+  if (first_off_us == 0) first_off_us = now;
+  if (now - first_off_us > hold_us) {
+    fprintf(stderr, "[xApp] KPM phase %" PRId64 " ms for over %" PRId64 " s; exiting to resubscribe\n", phase, hold_us / 1000000);
+    fflush(NULL);
+    _exit(4);
+  }
+}
