+int urr_receiver_ring_for_supi(const char *supi,urr_record_t *out,int64_t *received_us,int max){
+  int n=0;
+  pthread_mutex_lock(&lock);
+  for(size_t i=0;i<per_supi_count;i++){
+    if(strcmp(per_supi[i].r.supi,supi)!=0)continue;
+    int valid=0;
+    for(int k=0;k<URR_RING;k++)valid+=per_supi[i].ring[k].supi[0]!='\0';
+    int skip=valid>max?valid-max:0;
+    for(int k=0;k<URR_RING;k++){
+      int j=(per_supi[i].ring_head+k)%URR_RING; /* oldest first */
+      if(!per_supi[i].ring[j].supi[0])continue;
+      if(skip){skip--;continue;}
+      out[n]=per_supi[i].ring[j];if(received_us)received_us[n]=per_supi[i].ring_rx[j];n++;
+    }
+    break;
+  }
+  pthread_mutex_unlock(&lock);
+  return n;
+}
+
+int urr_receiver_profile_latest(const char *supi,profile_record_t *out,int64_t *received_us){
+  int found=0;
+  pthread_mutex_lock(&lock);
+  for(size_t i=0;i<profile_count;i++){
+    if(strcmp(profiles[i].supi,supi)!=0)continue;
+    int64_t best=-1;
+    for(int k=0;k<PROFILE_RING;k++)
+      if(profiles[i].ring[k].supi[0] && profiles[i].rx[k]>best){best=profiles[i].rx[k];*out=profiles[i].ring[k];if(received_us)*received_us=best;found=1;}
+    break;
+  }
+  pthread_mutex_unlock(&lock);
   return found;
 }
 
