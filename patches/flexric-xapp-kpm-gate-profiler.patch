+#define MAX_GATE_NODES 8
+static struct { char node[32]; double trust; bool masked; } gate_nodes[MAX_GATE_NODES];
+
+static int gate_slot(const char *node) {
+  int free_slot = -1;
+  for (int i = 0; i < MAX_GATE_NODES; i++) {
+    if (gate_nodes[i].node[0] && strcmp(gate_nodes[i].node, node) == 0) return i;
+    if (!gate_nodes[i].node[0] && free_slot < 0) free_slot = i;
+  }
+  if (free_slot >= 0) {
+    snprintf(gate_nodes[free_slot].node, sizeof(gate_nodes[free_slot].node), "%s", node);
+    gate_nodes[free_slot].trust = 1.0;
+  }
+  return free_slot;
+}
+
+double features_kpm_trust(const char *node) {
+  const int i = gate_slot(node);
+  return i < 0 ? 1.0 : gate_nodes[i].trust;
+}
+
+/* c_t of a vector from the profile of its own second. A second where neither
+   side reaches the byte floor says nothing about the node. */
+static void gate_sample(features_t *f) {
+  const profile_record_t *p = &f->prof;
+  const double w = p->window_ms ? p->window_ms / 1000.0 : 1.0;
+  const double kpm = f->rate_ul * 125.0; /* kbit/s -> bytes/s */
+  double core = ((double)p->ul_bytes - cfg.gate_beta * (double)p->ul_pkts) / w;
+  if (core < 0) core = 0;
+  f->c_t = log((kpm + cfg.gate_eps_bytes) / (core + cfg.gate_eps_bytes));
+  f->has_gate = true;
+  const int i = gate_slot(f->node);
+  if (i < 0 || (kpm < cfg.gate_eps_bytes && core < cfg.gate_eps_bytes)) return;
+  const bool in_band = f->c_t >= cfg.gate_lo && f->c_t <= cfg.gate_hi;
+  gate_nodes[i].trust += cfg.gate_alpha * ((in_band ? 1.0 : 0.0) - gate_nodes[i].trust);
+  const bool masked = gate_nodes[i].masked ? gate_nodes[i].trust < cfg.gate_trust_min + 0.05 : gate_nodes[i].trust < cfg.gate_trust_min;
+  if (masked != gate_nodes[i].masked) {
+    gate_nodes[i].masked = masked;
+    policy_flag_node(f->node, gate_nodes[i].trust, masked, f->c_t);
+  }
+}
