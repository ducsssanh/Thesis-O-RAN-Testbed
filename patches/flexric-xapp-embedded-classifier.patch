 }
+
+/* ---------- embedded model (classifier.kind "xgb") ----------
+   Scored per KPM second at t + delta_s (t = whole second of the KPM collect
+   time), as the offline pipeline does: the UPF profile of that second counts
+   only if it arrived by then. The 15 per-second inputs follow
+   scripts/drl/episodes.py features() + clf_features.py + train_clf.py
+   cur("f15"); KPM columns are zero while this UE's KPM is masked, profiler
+   columns while the profile is late. The decision is the xApp's: the gate
+   (trust, mask, framing guard), the model's two alarm rules, the escalation
+   by response, then the policy ladder (policy_apply). */
+static FILE *clf_log;
+
+int clf_log_open(const char *path) {
+  if (path && !(clf_log = fopen(path, "a"))) {
+    fprintf(stderr, "[defense] cannot open %s\n", path);
+    return -1;
+  }
+  return 0;
+}
+
+void clf_log_close(void) {
+  if (clf_log) fclose(clf_log);
+  clf_log = NULL;
+}
+
+static float clip(double v, double lo, double hi) { return (float)(v < lo ? lo : v > hi ? hi : v); }
+
+/* the 15 per-second inputs of vector f (see above); *late: no profile of the second by t + delta */
+static void clf_inputs(const ue_t *u, const features_t *f, float c[15], bool *late, double *trust, bool *masked) {
+  const int64_t t_us = f->collect_us / 1000000 * 1000000;
+  const double delta = clf_delta_s();
+  /* arrival in whole ms, as the offline builder reads received_unix_ms */
+  const int64_t rx_ms = (f->collect_us + llround(f->profile_age_s * 1e6)) / 1000;
+  const double prof_age = f->has_profile && f->profile_offset_s == 0 ? rx_ms / 1000.0 - t_us / 1e6 : NAN;
+  *late = isnan(prof_age) || prof_age > delta;
+  *trust = features_kpm_trust(u->supi);
+  *masked = features_kpm_masked(u->supi);
+  const profile_record_t *p = &f->prof;
+  const double w = p->window_ms ? p->window_ms / 1000.0 : 1.0;
+  double ul_kbps = 0, dl_kbps = 0, ul_pps = 0, dl_pps = 0, ul_size = 0, dl_size = 0, ctw = 0;
+  if (!*late) {
+    ul_kbps = p->ul_bytes * 8 / 1000.0 / w; dl_kbps = p->dl_bytes * 8 / 1000.0 / w;
+    ul_pps = p->ul_pkts / w; dl_pps = p->dl_pkts / w;
+    ul_size = p->ul_pkts ? (double)p->ul_bytes / p->ul_pkts / 1500.0 : 0;
+    dl_size = p->dl_pkts ? (double)p->dl_bytes / p->dl_pkts / 1500.0 : 0;
+    ctw = f->has_gate ? f->c_t_w : 0;
+  }
+  const float c6 = (float)log1p(ul_kbps), c7 = (float)log1p(dl_kbps), c8 = (float)log1p(ul_pps), c9 = (float)log1p(dl_pps);
+  const float c2 = *masked ? 0.f : (float)(f->prb_ul / 100.0), c3 = *masked ? 0.f : (float)(f->prb_dl / 100.0);
+  c[0] = c6; c[1] = c7; c[2] = c8; c[3] = c9; c[4] = c2; c[5] = c3;
+  c[6] = log1pf(c2 * 100.f / (1.f + expm1f(c6))); /* float32, as train_clf.py cur() on the float32 columns */
+  c[7] = (float)ul_size; c[8] = (float)dl_size;
+  c[9] = c7 - c6;
+  c[10] = clip(ctw, -3, 3);
+  c[11] = (float)*trust;
+  c[12] = *masked ? 1.f : 0.f;
+  c[13] = clip(f->at_us / 1e6 - (double)(t_us / 1000000), 0, 3); /* arrival_ts - t of the offline builder */
+  c[14] = isnan(prof_age) ? 3.f : clip(prof_age, 0, 3);
+}
+
+/* direction 1: at level 2 for grace_s, offered UL (profile, counted before
+   the UPF policy) above (1 + over_ratio) x the cap in k of the last n ACTIVE
+   seconds (core UL >= 8 kbit/s) -> the UE does not back off -> level 3 */
+static bool escalate(ue_t *u, const features_t *f, bool late, int64_t now) {
+  if (u->level != 2) {
+    u->limited_since_us = 0;
+    u->esc_n = u->esc_head = 0;
+    return false;
+  }
+  if (!u->limited_since_us) u->limited_since_us = now;
+  double cap_ul, cap_dl;
+  core_want(u, &cap_ul, &cap_dl);
+  const double offered = late ? 0 : features_core_ul_kbps(f);
+  const bool over = !late && cap_ul > 0 && offered > (1.0 + cfg.esc_over_ratio) * cap_ul;
+  if (!late && offered >= 8.0) { /* active seconds only: an ON/OFF flood cannot dilute the count with silent seconds */
+    u->esc_hist[u->esc_head] = over;
+    u->esc_head = (u->esc_head + 1) % 32;
+    if (u->esc_n < 32) u->esc_n++;
+  }
+  if (!cfg.esc_enabled || now - u->limited_since_us < (int64_t)cfg.esc_grace_s * 1000000) return false;
+  int hits = 0, m = u->esc_n < cfg.esc_n ? u->esc_n : cfg.esc_n;
+  for (int i = 0; i < m; i++) hits += u->esc_hist[(u->esc_head - 1 - i + 64) % 32];
+  return m >= cfg.esc_n && hits >= cfg.esc_k;
+}
+
+static void clf_line(const ue_t *u, const features_t *f, const clf_out_t *o, const cls_result_t *r, bool late, double trust,
+                     bool masked, bool esc, uint64_t decision, int64_t now) {
+  if (!clf_log) return;
+  json_object *j = json_object_new_object(), *x = json_object_new_array();
+  json_object_object_add(j, "supi", json_object_new_string(u->supi));
+  json_object_object_add(j, "seq", json_object_new_uint64(f->seq));
+  json_object_object_add(j, "t", json_object_new_int64(f->collect_us / 1000000));
+  json_object_object_add(j, "collect_ms", json_object_new_int64(f->collect_us / 1000));
+  json_object_object_add(j, "scored_ms", json_object_new_int64(now / 1000));
+  for (int i = 0; i < CLF_NF; i++) json_object_array_add(x, json_object_new_double(o->x[i]));
+  json_object_object_add(j, "x", x);
+  json_object_object_add(j, "z", json_object_new_double(o->z));
+  json_object_object_add(j, "soft", json_object_new_boolean(o->soft));
+  json_object_object_add(j, "block", json_object_new_boolean(o->block));
+  json_object_object_add(j, "soft_stat", json_object_new_double(o->soft_stat));
+  json_object_object_add(j, "block_stat", json_object_new_double(o->block_stat));
+  json_object_object_add(j, "late", json_object_new_boolean(late));
+  json_object_object_add(j, "trust", json_object_new_double(trust));
+  json_object_object_add(j, "masked", json_object_new_boolean(masked));
+  if (f->has_gate) json_object_object_add(j, "c_t_w", json_object_new_double(f->c_t_w));
+  json_object_object_add(j, "esc", json_object_new_boolean(esc));
+  json_object_object_add(j, "label", json_object_new_string(label_name(r->label)));
+  json_object_object_add(j, "kind", json_object_new_string(r->kind));
+  json_object_object_add(j, "want_level", json_object_new_int(r->want_level));
+  json_object_object_add(j, "level", json_object_new_int(u->level));
+  json_object_object_add(j, "actuate", json_object_new_boolean(cfg.actuate));
+  if (decision) json_object_object_add(j, "decision_id", json_object_new_uint64(decision));
+  fputs(json_object_to_json_string_ext(j, JSON_C_TO_STRING_PLAIN), clf_log);
+  fputc('\n', clf_log);
+  fflush(clf_log);
+  json_object_put(j);
+}
+
+/* called by the worker (st_lock held) every tick: score the vectors whose
+   second is due, oldest first */
+void classifier_tick(int64_t now) {
+  if (!cfg.enabled || !cfg.xgb || !clf_ready()) return;
+  const int64_t delta_us = (int64_t)(clf_delta_s() * 1e6);
+  for (int i = 0; i < MAX_UES; i++) {
+    ue_t *u = &ues[i];
+    if (!u->used) continue;
+    features_fill_urr(u, now);
+    for (int k = 0; k < u->win_len; k++) {
+      features_t *f = &u->win[(u->win_head - u->win_len + k + 2 * WINDOW_MAX) % WINDOW_MAX];
+      if (f->clf_done || f->seq <= u->clf.last_seq) continue;
+      if (now < f->collect_us / 1000000 * 1000000 + delta_us) break; /* not due yet; keep the order */
+      float c[15];
+      bool late, masked;
+      double trust;
+      clf_inputs(u, f, c, &late, &trust, &masked);
+      clf_out_t o;
+      clf_step(&u->clf, c, &o);
+      window_t w;
+      features_window(u, cfg.n, &w);
+      cls_result_t r;
+      rules(&w, &r); /* fusion hits and the idle-cell count only */
+      r.label = LABEL_BENIGN;
+      r.kind[0] = r.reason[0] = '\0';
+      r.want_level = 0;
+      r.score = 1.0 / (1.0 + exp(-o.z));
+      snprintf(r.source, sizeof(r.source), "xgb");
+      snprintf(r.layer, sizeof(r.layer), "both");
+      /* gate guard: KPM of this UE untrusted and above what the core counts
+         (framing): no action on the UE, the gNB is flagged (policy_flag_ue) */
+      const bool framed = masked && f->has_gate && f->c_t_w > cfg.gate_hi;
+      const bool esc = escalate(u, f, late, now);
+      if (framed && (o.soft || o.block)) {
+        r.label = LABEL_SUSPICIOUS;
+        snprintf(r.kind, sizeof(r.kind), "framed_kpm");
+      } else if (o.block || esc) {
+        r.label = LABEL_ATTACK;
+        r.want_level = 3;
+        snprintf(r.kind, sizeof(r.kind), "%s", o.block ? "model_block" : "esc_response");
+      } else if (o.soft) {
+        r.label = LABEL_ATTACK;
+        r.want_level = 2;
+        snprintf(r.kind, sizeof(r.kind), "model_soft");
+      }
+      snprintf(r.reason, sizeof(r.reason), "z %.2f, %s %.0f, k2030 %.0f%s", o.z, clf_soft_rule(), o.soft_stat, o.block_stat,
+               masked ? ", KPM masked" : "");
+      const uint64_t decision = policy_apply(u, f, &r, now);
+      if (cfg.actuate) actuators_verify(u, f, now);
+      features_log(u, f, &r, decision);
+      clf_line(u, f, &o, &r, late, trust, masked, esc, decision, now);
+      f->clf_done = true;
+      u->clf.last_seq = f->seq;
+    }
+  }
+}
diff -ruN a/examples/xApp/c/monitor/clf_xgb.c b/examples/xApp/c/monitor/clf_xgb.c
--- a/examples/xApp/c/monitor/clf_xgb.c	1970-01-01 08:00:00.000000000 +0800
+++ b/examples/xApp/c/monitor/clf_xgb.c	2026-11-10 02:46:46.708782346 +0700
@@ -0,0 +1,269 @@
+/* Embedded XGBoost classifier (see clf_xgb.h). The model file is written by
+   scripts/ml/export_clf.py; the tree walk follows XGBoost: go left when
+   x < split (float), a missing value takes default_left, a leaf's value is
+   its split_conditions entry. Ensemble logit = mean over seeds of
+   (base_margin + sum of leaves) / temperature. */
+#include "clf_xgb.h"
+#include <json-c/json.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+  int n;
+  int *left, *right, *feat;
+  float *thr;
+  unsigned char *dleft;
+} tree_t;
+
+typedef struct {
+  double temperature, base_margin;
+  int n_trees;
+  tree_t *trees;
+} booster_t;
+
+typedef struct {
+  char rule[12];
+  int k, n;               /* k of n (thr: 1 of 1); 0 for cusum */
+  bool active;            /* a<k><n>: k of the last n ACTIVE seconds (silent seconds are skipped, not counted as misses) */
+  bool mean;              /* mean<n><k> (2026-11-10): mean logit of the last n ACTIVE seconds, once at least k of them exist */
+  double threshold, prior;
+} rule_t;
+
+/* alarm rules, as eval_block_rules.py RULES */
+static const struct { const char *name; int k, n; bool active, mean; } RULES[] = {
+  {"thr", 1, 1, false, false}, {"k23", 2, 3, false, false}, {"k35", 3, 5, false, false}, {"k610", 6, 10, false, false},
+  {"k1220", 12, 20, false, false}, {"k2030", 20, 30, false, false},
+  {"a2030", 20, 30, true, false}, {"a1220", 12, 20, true, false}, {"a1020", 10, 20, true, false},
+  {"a510", 5, 10, true, false}, {"a612", 6, 12, true, false}, {"a815", 8, 15, true, false}, {"a816", 8, 16, true, false},
+  {"a1015", 10, 15, true, false},
+  {"mean66", 6, 6, true, true}, {"mean610", 6, 10, true, true}, {"mean812", 8, 12, true, true}, {"mean1010", 10, 10, true, true},
+  {"mean2010", 10, 20, true, true}, {"mean3010", 10, 30, true, true},
+};
+
+static booster_t *B;
+static int nB;
+static rule_t soft, block;
+static double delta_s = 0.2;
+static int win_s = 10;
+static int nf = 25;      /* inputs the model expects (features list of the model file) */
+static bool ready;
+
+static int set_rule(rule_t *r, json_object *o) {
+  json_object *x = NULL;
+  if (!o || !json_object_object_get_ex(o, "rule", &x)) return -1;
+  snprintf(r->rule, sizeof(r->rule), "%s", json_object_get_string(x));
+  r->threshold = json_object_object_get_ex(o, "threshold", &x) ? json_object_get_double(x) : 0;
+  r->prior = json_object_object_get_ex(o, "prior", &x) ? json_object_get_double(x) : 0;
+  r->active = r->mean = false;
+  if (strcmp(r->rule, "cusum") == 0) { r->k = 0; r->n = 0; return 0; }
+  for (size_t i = 0; i < sizeof(RULES) / sizeof(RULES[0]); i++)
+    if (strcmp(r->rule, RULES[i].name) == 0) {
+      r->k = RULES[i].k; r->n = RULES[i].n; r->active = RULES[i].active; r->mean = RULES[i].mean;
+      return 0;
+    }
+  return -1;
+}
+
+static int load_tree(tree_t *t, json_object *o) {
+  json_object *l, *r, *f, *s, *d;
+  if (!json_object_object_get_ex(o, "left", &l) || !json_object_object_get_ex(o, "right", &r) ||
+      !json_object_object_get_ex(o, "feat", &f) || !json_object_object_get_ex(o, "thr", &s) ||
+      !json_object_object_get_ex(o, "default_left", &d))
+    return -1;
+  t->n = (int)json_object_array_length(l);
+  t->left = malloc(sizeof(int) * t->n); t->right = malloc(sizeof(int) * t->n); t->feat = malloc(sizeof(int) * t->n);
+  t->thr = malloc(sizeof(float) * t->n); t->dleft = malloc(t->n);
+  for (int i = 0; i < t->n; i++) {
+    t->left[i] = json_object_get_int(json_object_array_get_idx(l, i));
+    t->right[i] = json_object_get_int(json_object_array_get_idx(r, i));
+    t->feat[i] = json_object_get_int(json_object_array_get_idx(f, i));
+    t->thr[i] = (float)json_object_get_double(json_object_array_get_idx(s, i));
+    json_object *dv = json_object_array_get_idx(d, i);
+    t->dleft[i] = json_object_is_type(dv, json_type_boolean) ? json_object_get_boolean(dv) : json_object_get_int(dv) != 0;
+    if (t->left[i] >= t->n || t->right[i] >= t->n || (t->left[i] >= 0 && (t->feat[i] < 0 || t->feat[i] >= CLF_NF))) return -1;
+  }
+  return 0;
+}
+
+int clf_load(const char *path) {
+  json_object *m = json_object_from_file(path), *x = NULL, *bs = NULL;
+  if (!m) {
+    fprintf(stderr, "[clf] cannot read %s\n", path);
+    return -1;
+  }
+  int rc = -1;
+  if (json_object_object_get_ex(m, "delta_s", &x)) delta_s = json_object_get_double(x);
+  if (json_object_object_get_ex(m, "win_s", &x)) win_s = json_object_get_int(x);
+  if (json_object_object_get_ex(m, "features", &x) && json_object_is_type(x, json_type_array)) nf = (int)json_object_array_length(x);
+  if (nf != 25 && nf != 31) goto out;
+  if (win_s < 1 || win_s > CLF_HIST) win_s = 10;
+  json_object *so = NULL, *bo = NULL;
+  json_object_object_get_ex(m, "soft", &so);
+  json_object_object_get_ex(m, "block", &bo);
+  if (set_rule(&soft, so) || set_rule(&block, bo) || soft.n > CLF_HIST || block.n > CLF_HIST) goto out;
+  if (!json_object_object_get_ex(m, "boosters", &bs)) goto out;
+  nB = (int)json_object_array_length(bs);
+  B = calloc(nB, sizeof(booster_t));
+  for (int b = 0; b < nB; b++) {
+    json_object *o = json_object_array_get_idx(bs, b), *tr = NULL;
+    B[b].temperature = json_object_object_get_ex(o, "temperature", &x) ? json_object_get_double(x) : 1.0;
+    B[b].base_margin = json_object_object_get_ex(o, "base_margin", &x) ? json_object_get_double(x) : 0.0;
+    if (!json_object_object_get_ex(o, "trees", &tr)) goto out;
+    B[b].n_trees = (int)json_object_array_length(tr);
+    B[b].trees = calloc(B[b].n_trees, sizeof(tree_t));
+    for (int i = 0; i < B[b].n_trees; i++)
+      if (load_tree(&B[b].trees[i], json_object_array_get_idx(tr, i))) goto out;
+  }
+  ready = nB > 0;
+  rc = ready ? 0 : -1;
+  printf("[clf] %s: %d boosters, soft %s > %.4f, block %s > %.4f, delta %.2f s, window %d s\n", path, nB, soft.rule, soft.threshold,
+         block.rule, block.threshold, delta_s, win_s);
+out:
+  if (rc) fprintf(stderr, "[clf] bad model file %s\n", path);
+  json_object_put(m);
+  return rc;
+}
+
+bool clf_ready(void) { return ready; }
+int clf_nf(void) { return nf; }
+const char *clf_soft_rule(void) { return soft.rule; }
+double clf_soft_threshold(void) { return soft.threshold; }
+double clf_block_threshold(void) { return block.threshold; }
+double clf_delta_s(void) { return delta_s; }
+
+float clf_margin(const float *x) {
+  double z = 0;
+  for (int b = 0; b < nB; b++) {
+    double m = B[b].base_margin;
+    for (int i = 0; i < B[b].n_trees; i++) {
+      const tree_t *t = &B[b].trees[i];
+      int k = 0;
+      while (t->left[k] >= 0) {
+        const float v = x[t->feat[k]];
+        k = isnan(v) ? (t->dleft[k] ? t->left[k] : t->right[k]) : (v < t->thr[k] ? t->left[k] : t->right[k]);
+      }
+      m += t->thr[k];
+    }
+    z += m / B[b].temperature;
+  }
+  return (float)(z / nB);
+}
+
+/* the i-th newest entry of a ring (0 = newest) */
+#define AT(s, a, i) ((s)->a[((s)->head - 1 - (i) + 2 * CLF_HIST) % CLF_HIST])
+
+static float np_sum(const float *a, int n);
+
+static bool fire(const clf_state_t *s, const rule_t *r, double *cusum, float z, double *stat) {
+  if (r->n == 0) { /* CUSUM on the logit */
+    *cusum = fmax(0.0, *cusum + z - r->prior);
+    *stat = *cusum;
+    return *cusum > r->threshold;
+  }
+  int hits = 0;
+  if (r->mean) { /* eval_block_rules.py "mean": np.mean of the float32 logits of the last n active seconds, oldest first */
+    const int m = s->na < r->n ? s->na : r->n;
+    if (m < r->k) { *stat = 0; return false; }
+    float a[CLF_HIST];
+    for (int j = 0; j < m; j++) a[j] = s->za[(s->heada - m + j + 2 * CLF_HIST) % CLF_HIST];
+    const float mu = np_sum(a, m) / (float)m;
+    *stat = mu;
+    return mu > r->threshold;
+  }
+  if (r->active) {
+    const int m = s->na < r->n ? s->na : r->n;
+    for (int i = 0; i < m; i++) hits += s->za[(s->heada - 1 - i + 2 * CLF_HIST) % CLF_HIST] > r->threshold;
+    *stat = hits;
+    return hits >= r->k;
+  }
+  const int m = s->n < r->n ? s->n : r->n;
+  for (int i = 0; i < m; i++) hits += AT(s, z, i) > r->threshold;
+  *stat = hits;
+  return hits >= r->k;
+}
+
+/* numpy's pairwise float32 sum (umath loops, n <= 128), so that the window
+   inputs are bit-identical to train_clf.py win_summary() on float32 arrays */
+static float np_sum(const float *a, int n) {
+  if (n < 8) {
+    float r = 0.f;
+    for (int i = 0; i < n; i++) r += a[i];
+    return r;
+  }
+  float r[8];
+  for (int j = 0; j < 8; j++) r[j] = a[j];
+  int i;
+  for (i = 8; i < n - (n % 8); i += 8)
+    for (int j = 0; j < 8; j++) r[j] += a[i + j];
+  float res = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]));
+  for (; i < n; i++) res += a[i];
+  return res;
+}
+
+static float np_mean(const float *a, int n) { return (float)((double)np_sum(a, n) / n); }
+
+static float np_max(const float *a, int n) {
+  float m = a[0];
+  for (int i = 1; i < n; i++) if (a[i] > m) m = a[i];
+  return m;
+}
+
+static float np_std(const float *a, int n) {
+  const float m = (float)((double)np_sum(a, n) / n);
+  float d[CLF_HIST];
+  for (int i = 0; i < n; i++) { d[i] = a[i] - m; d[i] = d[i] * d[i]; }
+  return sqrtf((float)((double)np_sum(d, n) / n));
+}
+
+void clf_step(clf_state_t *s, const float cur[15], clf_out_t *out) {
+  memset(out, 0, sizeof(*out));
+  memcpy(out->x, cur, 15 * sizeof(float));
+  s->c6[s->head] = cur[0]; s->c8[s->head] = cur[2]; s->c2[s->head] = cur[4]; s->c7[s->head] = cur[1];
+  s->head = (s->head + 1) % CLF_HIST;
+  if (s->n < CLF_HIST) s->n++;
+  /* win_summary(raw, W) of train_clf.py over the last W seconds, oldest first, float32 as numpy */
+  const int W = s->n < win_s ? s->n : win_s;
+  float k[CLF_HIST], p[CLF_HIST], r[CLF_HIST];
+  int busy = 0, run = 0, best = 0;
+  for (int j = 0; j < W; j++) {
+    const int i = W - 1 - j;
+    k[j] = expm1f(AT(s, c6, i)); p[j] = expm1f(AT(s, c8, i)); r[j] = AT(s, c2, i) * 100.f;
+    const bool b = k[j] >= 8.f;
+    busy += b;
+    run = b ? 0 : run + 1;
+    if (run > best) best = run;
+  }
+  const float m = np_mean(k, W), mk = np_max(k, W);
+  float *w = out->x + 15;
+  w[0] = log1pf(m); w[1] = log1pf(mk); w[2] = log1pf(np_mean(p, W)); w[3] = log1pf(np_max(p, W));
+  w[4] = (float)((double)np_mean(r, W) / 100.0); w[5] = (float)((double)np_max(r, W) / 100.0);
+  w[6] = (float)((double)busy / W);
+  w[7] = m > 0 ? np_std(k, W) / m : 0.f; w[8] = m > 0 ? mk / m : 0.f; w[9] = (float)((double)best / win_s);
+  if (nf == 31) { /* train_clf.py coupling(): UL-DL coupling over the last 10 s and 30 s, float32 as numpy */
+    float *c = out->x + 25;
+    for (int span = 0; span < 2; span++) {
+      const int L = span == 0 ? 10 : 30, n = s->n < L ? s->n : L;
+      float u[CLF_HIST], d[CLF_HIST], ui[CLF_HIST];
+      int ni = 0;
+      for (int j = 0; j < n; j++) {
+        const int i = n - 1 - j;
+        u[j] = expm1f(AT(s, c6, i)); d[j] = expm1f(AT(s, c7, i));
+        if (d[j] < 1.f) ui[ni++] = u[j];
+      }
+      const float su = np_sum(u, n), sd = np_sum(d, n), sui = ni ? np_sum(ui, ni) : 0.f;
+      if (span == 0) { c[0] = log1pf(np_mean(d, n)); c[1] = log1pf(np_max(d, n)); c[2] = log1pf(sd) - log1pf(su); c[4] = su > 0 ? sui / su : 0.f; }
+      else { c[3] = log1pf(sd) - log1pf(su); c[5] = su > 0 ? sui / su : 0.f; }
+    }
+  }
+  out->z = clf_margin(out->x);
+  s->z[(s->head - 1 + CLF_HIST) % CLF_HIST] = out->z;
+  if (expm1f(cur[0]) >= 8.f) { /* active second: core UL >= 8 kbit/s, as eval_block_rules.py active() */
+    s->za[s->heada] = out->z;
+    s->heada = (s->heada + 1) % CLF_HIST;
+    if (s->na < CLF_HIST) s->na++;
+  }
+  out->soft = fire(s, &soft, &s->cusum_soft, out->z, &out->soft_stat);
+  out->block = fire(s, &block, &s->cusum_block, out->z, &out->block_stat);
+}
