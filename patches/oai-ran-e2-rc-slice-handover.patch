+// S-NSSAI of a control message: SST (1 octet) and SD (3 octets, big endian);
+// false when the message has no SD
+static bool find_snssai(const e2sm_rc_ctrl_msg_frmt_1_t* msg, uint8_t* sst, uint32_t* sd)
+{
+  const ran_parameter_value_t* st = find_ran_param_value(msg->ran_param, msg->sz_ran_param, RC_PRB_QUOTA_SST);
+  const ran_parameter_value_t* d = find_ran_param_value(msg->ran_param, msg->sz_ran_param, RC_PRB_QUOTA_SD);
+  if (st == NULL || st->type != OCTET_STRING_RAN_PARAMETER_VALUE || st->octet_str_ran.len != 1 || d == NULL
+      || d->type != OCTET_STRING_RAN_PARAMETER_VALUE || d->octet_str_ran.len != 3)
+    return false;
+  *sst = st->octet_str_ran.buf[0];
+  *sd = (uint32_t)d->octet_str_ran.buf[0] << 16 | (uint32_t)d->octet_str_ran.buf[1] << 8 | d->octet_str_ran.buf[2];
+  return true;
