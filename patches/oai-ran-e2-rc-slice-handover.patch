+// index of the RAN slice with this S-NSSAI, -1 if none. Call with the
+// scheduler lock held.
+static int find_e2_slice(const gNB_MAC_INST* mac, uint8_t sst, uint32_t sd)
+{
+  for (int i = 0; i < NR_E2_MAX_SLICES; i++)
+    if (mac->e2_slices[i].used && mac->e2_slices[i].sst == sst && mac->e2_slices[i].sd == sd)
+      return i;
+  return -1;
+}
