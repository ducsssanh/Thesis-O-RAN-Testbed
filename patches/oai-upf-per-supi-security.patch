@@ -0,0 +1,42 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+#ifndef __SEC_POLICY_MAPS_H__
+#define __SEC_POLICY_MAPS_H__
+
+#include <linux/bpf.h>
+#include <bpf/bpf_helpers.h>
+#include "sec_policy_types.h"
+
+/*
+ * Owned by session_lookup_ip (sized in SessionLookupIPProgram::ConfigureMaps)
+ * and shared into session_lookup_eth via bpf_map__reuse_fd.
+ */
+
+/* IMSI -> policy. Not read by XDP: the subscriber memory that userspace
+ * derives sec_policy_by_seid from when a session is established. */
+struct {
+  __uint(type, BPF_MAP_TYPE_HASH);
+  __uint(max_entries, 1); /* Runtime: UPF_SEC_MAX_POLICIES */
+  __type(key, __u64);
+  __type(value, struct sec_policy);
+} sec_policy_by_supi SEC(".maps");
+
+/* SEID -> policy of the session's subscriber. Removed with the session. */
+struct {
+  __uint(type, BPF_MAP_TYPE_HASH);
+  __uint(max_entries, 1); /* Runtime: MAX_PDU_SESSIONS */
+  __type(key, __u64);
+  __type(value, struct sec_policy);
+} sec_policy_by_seid SEC(".maps");
+
+/* SEID -> drop / match counters. Dropped packets never reach URR. */
+struct {
+  __uint(type, BPF_MAP_TYPE_PERCPU_HASH);
+  __uint(max_entries, 1); /* Runtime: MAX_PDU_SESSIONS */
+  __type(key, __u64);
+  __type(value, struct sec_stats);
+} sec_stats_by_seid SEC(".maps");
+
+#endif /* __SEC_POLICY_MAPS_H__ */
diff -ruN a/src/upf_app/kernel/include/sec_policy_types.h b/src/upf_app/kernel/include/sec_policy_types.h
--- a/src/upf_app/kernel/include/sec_policy_types.h	1970-01-01 08:00:00.000000000 +0800
+++ b/src/upf_app/kernel/include/sec_policy_types.h	2026-10-05 19:57:24.897081789 +0700
@@ -0,0 +1,56 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+#ifndef __SEC_POLICY_TYPES_H__
+#define __SEC_POLICY_TYPES_H__
+
+#include <linux/types.h>
+
+/* ==========================================================================
+ * Per-SUPI security policy (lab extension, not 3GPP)
+ *
+ * Written by the UPF Security API (control/SecurityPolicyStore.cpp):
+ *   sec_policy_by_supi  IMSI (u64)  -> struct sec_policy   memory per subscriber
+ *   sec_policy_by_seid  SEID (u64)  -> struct sec_policy   derived per live session
+ * Read by session_lookup_ip / session_lookup_eth (sec_policy.h) before
+ * PDR match, so a dropped packet never touches the PFCP rules.
+ * ========================================================================== */
+
+enum sec_action {
+  SEC_ACTION_NONE      = 0,
+  SEC_ACTION_MONITOR   = 1, /* count, forward */
+  SEC_ACTION_RATELIMIT = 2, /* token bucket per direction, drop on empty */
+  SEC_ACTION_BLOCK     = 3, /* drop UL and DL */
+};
+
+struct sec_policy {
+  __u32 action; /* enum sec_action */
+  __u32 level;  /* escalation level given by the xApp (informative) */
+  __u64 rate_ul_bytes_s; /* RATELIMIT: 0 = no limit in this direction */
+  __u64 rate_dl_bytes_s;
+  __u64 burst_ul_bytes; /* RATELIMIT: bucket depth */
+  __u64 burst_dl_bytes;
+  __u64 expires_at_ns; /* bpf_ktime_get_ns() clock; 0 = never */
+  __u64 epoch;
+  /* Token bucket state, updated by XDP without locking (approximate). */
+  __u64 tokens_ul;
+  __u64 tokens_dl;
+  __u64 last_ul_ns;
+  __u64 last_dl_ns;
+};
+
+/* sec_stats_by_seid value (PERCPU_HASH, summed by userspace). */
+struct sec_stats {
+  __u64 drop_ul_pkts;
+  __u64 drop_ul_bytes;
+  __u64 drop_dl_pkts;
+  __u64 drop_dl_bytes;
+  __u64 seen_ul_pkts; /* packets matched by an active policy, any verdict */
+  __u64 seen_ul_bytes;
+  __u64 seen_dl_pkts;
+  __u64 seen_dl_bytes;
+  __u64 last_drop_ns;
+};
+
+#endif /* __SEC_POLICY_TYPES_H__ */
