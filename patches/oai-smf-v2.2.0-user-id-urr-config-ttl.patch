+
+//------------------------------------------------------------------------------
+void smf_pdu_session::clear_up_inactive() {
+  std::unique_lock lock(m_pdu_session_mutex);
+  up_inactive_since = {};
+}
+
+//------------------------------------------------------------------------------
+int64_t smf_pdu_session::get_up_inactive_seconds() const {
+  std::shared_lock lock(m_pdu_session_mutex);
+  if (up_inactive_since == std::chrono::steady_clock::time_point{}) return -1;
+  return std::chrono::duration_cast<std::chrono::seconds>(
+             std::chrono::steady_clock::now() - up_inactive_since)
+      .count();
+}
+
+//------------------------------------------------------------------------------
+int64_t smf_pdu_session::get_upCnx_deactivated_seconds() const {
+  std::shared_lock lock(m_pdu_session_mutex);
+  if (upCnx_state != upCnx_state_e::UPCNX_STATE_DEACTIVATED ||
+      upCnx_deactivated_at == std::chrono::steady_clock::time_point{})
+    return -1;
+  return std::chrono::duration_cast<std::chrono::seconds>(
+             std::chrono::steady_clock::now() - upCnx_deactivated_at)
+      .count();
+}
