+//------------------------------------------------------------------------------
+void smf_app::start_session_ttl_timer() {
+  uint32_t ttl = smf_cfg->smf()->get_ttl_deactivated_release_s();
+  if (ttl == 0) return;
+  // Sweep at a quarter of the TTL, between 1 s and 10 s
+  uint32_t period = std::min<uint32_t>(10, std::max<uint32_t>(1, ttl / 4));
+  itti_inst->timer_setup(
+      period, 0, TASK_SMF_APP, TASK_SMF_APP_TIMEOUT_SESSION_TTL, 0);
+}
+
+//------------------------------------------------------------------------------
+void smf_app::timer_session_ttl(timer_id_t, uint64_t) {
+  uint32_t ttl = smf_cfg->smf()->get_ttl_deactivated_release_s();
+  // Newest SM Context ID of every (SUPI, PDU Session ID): older ones are kept
+  // in the map after a release and would point at a re-established session
+  std::map<std::pair<std::string, pdu_session_id_t>, scid_t> sessions;
+  {
+    std::shared_lock lock(m_scid2smf_context);
+    for (const auto& it : scid2smf_context) {
+      if (it.second)
+        sessions[{it.second->supi, it.second->pdu_session_id}] = it.first;
+    }
+  }
+  for (const auto& [key, scid] : sessions) {
+    if (!is_supi_2_smf_context(key.first)) continue;
+    std::shared_ptr<smf_context> sc = supi_2_smf_context(key.first);
+    if (sc) sc->release_deactivated_pdu_session(key.second, scid, ttl);
   }
+  start_session_ttl_timer();
 }
 
