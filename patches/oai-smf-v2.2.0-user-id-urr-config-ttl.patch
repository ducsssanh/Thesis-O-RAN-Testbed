 //------------------------------------------------------------------------------
+bool smf_context::release_deactivated_pdu_session(
+    const pdu_session_id_t& psi, const scid_t& scid, uint32_t ttl_s) {
+  std::shared_ptr<smf_pdu_session> sp = {};
+  if (!find_pdu_session(psi, sp)) return false;
+  int64_t deactivated = sp->get_upCnx_deactivated_seconds();
+  int64_t inactive    = sp->get_up_inactive_seconds();
+  int64_t idle        = std::max(deactivated, inactive);
+  if (idle < 0 || idle < (int64_t) ttl_s) return false;
+
+  Logger::smf_app().info(
+      "Session TTL %s: PDU Session (SUPI %s, PDU Session ID %d, SCID " SCID_FMT
+      ") %s for %ld s >= %u s, network-requested release",
+      deactivated >= inactive ? "T1" : "T2", supi.c_str(), psi, scid,
+      deactivated >= inactive ? "UP DEACTIVATED" : "user plane inactive", idle,
+      ttl_s);
+  // Same notifications as a completed PDU Session Release
+  event_sub.sm_context_status(scid, "RELEASED");
+  if (sp->get_pdu_session_status() == pdu_session_status_t::Active)
+    trigger_pdu_session_release(scid, 1);
+  return release_stale_pdu_session(psi);
+}
