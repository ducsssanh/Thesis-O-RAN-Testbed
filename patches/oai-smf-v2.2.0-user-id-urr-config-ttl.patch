+bool smf_session_procedure::supi_to_user_id(
+    const std::string& supi, pfcp::user_id_t& user_id) {
+  std::string digits = supi;
+  if (digits.rfind("imsi-", 0) == 0) digits = digits.substr(5);
+  if (digits.empty() || digits.size() > 15 ||
+      digits.find_first_not_of("0123456789") != std::string::npos)
+    return false;
+  user_id       = {};
+  user_id.imsif = 1;
+  // TBCD: first digit in the low nibble; dump_to() pads an odd count with 0xF
+  for (size_t i = 0; i < digits.size(); i++) {
+    uint8_t d = digits[i] - '0';
+    user_id.imsi.u1.b[i / 2] |= (i % 2) ? (d << 4) : d;
+  }
+  user_id.imsi.num_digits = digits.size();
+  user_id.length_of_imsi  = (digits.size() + 1) / 2;
+  return true;
+}
