--- a/src/agent/asio_agent.c
+++ b/src/agent/asio_agent.c
@@ -130,6 +130,10 @@
 
   const int events_ready = epoll_wait(io->efd, events, maxevents, timeout_ms);
   if (events_ready < 0) {
+    // A signal (e.g. SIGCHLD, profiling, debugger) interrupts the wait: same
+    // as a timeout, the caller polls again
+    if (errno == EINTR)
+      return -1;
     fprintf(stderr, "epoll_wait() returned -1: errno %d, %s\n", errno, strerror(errno));
     assert(0);
   }
