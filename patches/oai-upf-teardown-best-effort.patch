+template<class Key>
+size_t PdrMatchProgram::SweepSeid(
+    const std::shared_ptr<BPFMap>& map, uint64_t seid) {
+  if (!map) return 0;
+  // Collect first: deleting while iterating a hash map can restart or skip.
+  std::vector<Key> stale;
+  Key cur;
+  Key next;
+  std::memset(&cur, 0, sizeof(cur));
+  std::memset(&next, 0, sizeof(next));
+  int fd    = map->GetFd();
+  bool have = bpf_map_get_next_key(fd, nullptr, &next) == 0;
+  while (have) {
+    if (next.seid == seid) stale.push_back(next);
+    cur  = next;
+    have = bpf_map_get_next_key(fd, &cur, &next) == 0;
+  }
+  size_t removed = 0;
+  for (auto& key : stale) removed += map->RemoveIfPresent(key) ? 1 : 0;
+  return removed;
+}
