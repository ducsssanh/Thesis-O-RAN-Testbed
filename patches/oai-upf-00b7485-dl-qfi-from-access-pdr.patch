 static constexpr int64_t kEmptySlot = -1;
 
+// OAI SMF can install the default flow's QFI on the ACCESS PDR while omitting
+// both QFI and QER from the CORE PDR. In a single-flow session, the ACCESS QFI
+// is the only unambiguous value to put in the DL GTP-U PDU Session Container.
+// Never guess when the session has several distinct uplink QFIs.
+static uint8_t UniqueAccessQfi(
+    const std::shared_ptr<pfcp::pfcp_session>& session) {
+  uint8_t unique_qfi = 0;
+  for (const auto& candidate : session->pdrs) {
+    pfcp::pdi pdi;
+    pfcp::source_interface_t source_interface;
+    if (!candidate->get(pdi) || !pdi.get(source_interface) ||
+        source_interface.interface_value != INTERFACE_VALUE_ACCESS ||
+        !pdi.qfi.first) {
+      continue;
+    }
+    const auto qfi = pdi.qfi.second.qfi;
+    if (qfi == 0 || qfi > 63) continue;
+    if (unique_qfi != 0 && unique_qfi != qfi) return 0;
+    unique_qfi = qfi;
+  }
+  return unique_qfi;
+}
