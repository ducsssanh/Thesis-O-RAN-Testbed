+/* ---------- configuration ---------- */
+
+static double num(json_object *o, const char *k, double def) {
+  json_object *x = NULL;
+  if (o && json_object_object_get_ex(o, k, &x) && (json_object_is_type(x, json_type_int) || json_object_is_type(x, json_type_double)))
+    return json_object_get_double(x);
+  return def;
+}
+
+static void load_config(void) {
+  cfg = (config_t){.enabled = false, .profile = "lab", .ul_rate_kbps = 3000, .dl_rate_kbps = 15000, .k = 2, .n = 3,
+                   .max_prb_ratio = 10, .margin_pct = 4, .confirm_k = 5, .confirm_n = 6, .expiry_s = {60, 180},
+                   .sev_rate = 2, .sev_saturated = 1, .half_life_s = 60};
+  const char *env = getenv("DEFENSE_CONFIG");
+  json_object *c = env && *env ? json_tokener_parse(env) : NULL, *x = NULL;
+  if (!c) {
+    printf("[defense] no DEFENSE_CONFIG: detection disabled\n");
+    return;
+  }
+  if (json_object_object_get_ex(c, "enabled", &x)) cfg.enabled = json_object_get_boolean(x);
+  if (json_object_object_get_ex(c, "profile", &x) && json_object_is_type(x, json_type_string))
+    snprintf(cfg.profile, sizeof(cfg.profile), "%s", json_object_get_string(x));
+  json_object *d = NULL, *a = NULL, *f = NULL, *e = NULL, *s = NULL;
+  json_object_object_get_ex(c, "detector", &d);
+  json_object_object_get_ex(c, "action", &a);
+  json_object_object_get_ex(c, "confirm", &f);
+  json_object_object_get_ex(c, "expiryS", &e);
+  json_object_object_get_ex(c, "severity", &s);
+  cfg.ul_rate_kbps = num(d, "ulRateKbps", cfg.ul_rate_kbps);
+  cfg.dl_rate_kbps = num(d, "dlRateKbps", cfg.dl_rate_kbps);
+  cfg.ul_prb_pct = num(d, "ulPrbPct", 0);
+  cfg.dl_prb_pct = num(d, "dlPrbPct", 0);
+  cfg.k = (int)num(d, "hits", cfg.k);
+  cfg.n = (int)num(d, "samples", cfg.n);
+  cfg.max_prb_ratio = (int)num(a, "maxPrbRatio", cfg.max_prb_ratio);
+  cfg.margin_pct = num(f, "marginPct", cfg.margin_pct);
+  cfg.confirm_k = (int)num(f, "hits", cfg.confirm_k);
+  cfg.confirm_n = (int)num(f, "samples", cfg.confirm_n);
+  json_object *p = NULL;
+  if (e && json_object_object_get_ex(e, cfg.profile, &p) && json_object_is_type(p, json_type_array) && json_object_array_length(p) >= 2) {
+    cfg.expiry_s[0] = json_object_get_int(json_object_array_get_idx(p, 0));
+    cfg.expiry_s[1] = json_object_get_int(json_object_array_get_idx(p, 1));
+  }
+  cfg.sev_rate = num(s, "kpmRate", cfg.sev_rate);
+  cfg.sev_saturated = num(s, "quotaFull", cfg.sev_saturated);
+  cfg.half_life_s = num(c, "scoreHalfLifeS", cfg.half_life_s);
+  if (cfg.n < 1 || cfg.n > 32) cfg.n = 3;
+  if (cfg.k < 1 || cfg.k > cfg.n) cfg.k = cfg.n;
+  if (cfg.confirm_n < 1 || cfg.confirm_n > 32) cfg.confirm_n = 6;
+  if (cfg.confirm_k < 1 || cfg.confirm_k > cfg.confirm_n) cfg.confirm_k = cfg.confirm_n;
+  if (cfg.max_prb_ratio < 1 || cfg.max_prb_ratio > 99) cfg.max_prb_ratio = 10;
+  json_object_put(c);
+  printf("[defense] %s, profile %s: PDCP rate UL >= %.0f kbps or DL >= %.0f kbps in %d of %d samples -> PRB quota %d%%; "
+         "quota full %d of %d -> level 2; expiry %d/%d s\n",
+         cfg.enabled ? "enabled" : "disabled", cfg.profile, cfg.ul_rate_kbps, cfg.dl_rate_kbps, cfg.k, cfg.n, cfg.max_prb_ratio,
+         cfg.confirm_k, cfg.confirm_n, cfg.expiry_s[0], cfg.expiry_s[1]);
+}
+
+/* ---------- persistence and event log ---------- */
+
+static void iso(int64_t us, char *buf, size_t n) {
+  time_t t = (time_t)(us / 1000000);
+  struct tm tm;
+  gmtime_r(&t, &tm);
+  size_t len = strftime(buf, n, "%Y-%m-%dT%H:%M:%S", &tm);
+  snprintf(buf + len, n - len, ".%03dZ", (int)(us / 1000 % 1000));
+}
+
+static void event(json_object *o) {
+  if (events) {
+    fputs(json_object_to_json_string_ext(o, JSON_C_TO_STRING_PLAIN), events);
+    fputc('\n', events);
+    fflush(events);
+  }
+  json_object_put(o);
+}
+
+static json_object *event_base(const char *type, const ue_t *u, int64_t now) {
+  json_object *o = json_object_new_object();
+  json_object_object_add(o, "at_ms", json_object_new_int64(now / 1000));
+  json_object_object_add(o, "type", json_object_new_string(type));
+  json_object_object_add(o, "supi", json_object_new_string(u->supi));
+  json_object_object_add(o, "level", json_object_new_int(u->level));
+  return o;
+}
+
+static void exec_sql(const char *sql) {
+  char *err = NULL;
+  if (sqlite3_exec(db, sql, NULL, NULL, &err) != SQLITE_OK) {
+    fprintf(stderr, "[defense] SQLite: %s\n", err ? err : "?");
+    sqlite3_free(err);
+  }
+}
+
+static void save_reputation(const ue_t *u, int64_t now) {
+  if (!db) return;
+  sqlite3_stmt *q = NULL;
+  char exp[40], upd[40];
+  iso(u->expires_us, exp, sizeof(exp));
+  iso(now, upd, sizeof(upd));
+  if (sqlite3_prepare_v2(db, "INSERT INTO reputation(supi,level,score,expires_at,updated_at) VALUES(?,?,?,?,?) "
+                             "ON CONFLICT(supi) DO UPDATE SET level=excluded.level,score=excluded.score,"
+                             "expires_at=excluded.expires_at,updated_at=excluded.updated_at", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, u->supi, -1, SQLITE_TRANSIENT);
+    sqlite3_bind_int(q, 2, u->level);
+    sqlite3_bind_double(q, 3, u->score);
+    sqlite3_bind_text(q, 4, u->level ? exp : "", -1, SQLITE_TRANSIENT);
+    sqlite3_bind_text(q, 5, upd, -1, SQLITE_TRANSIENT);
+    sqlite3_step(q);
+  }
+  sqlite3_finalize(q);
+}
+
+static void save_evidence(const ue_t *u, int64_t now, const char *kind, double severity, double trust, const sample_t *s) {
+  char ref[96], at[40];
+  snprintf(ref, sizeof(ref), "kpm:node=%s/ue=%" PRIu64 "/t=%" PRId64, s->node, s->amf, s->collect_us / 1000);
+  iso(now, at, sizeof(at));
+  if (db) {
+    sqlite3_stmt *q = NULL;
+    if (sqlite3_prepare_v2(db, "INSERT INTO evidence(supi,at,layer,kind,severity,ref,trust) VALUES(?,?,'ran',?,?,?,?)", -1, &q, NULL) == SQLITE_OK) {
+      sqlite3_bind_text(q, 1, u->supi, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 2, at, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 3, kind, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_double(q, 4, severity);
+      sqlite3_bind_text(q, 5, ref, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_double(q, 6, trust);
+      sqlite3_step(q);
+    }
+    sqlite3_finalize(q);
+  }
+  json_object *o = event_base("evidence", u, now);
+  json_object_object_add(o, "kind", json_object_new_string(kind));
+  json_object_object_add(o, "severity", json_object_new_double(severity));
+  json_object_object_add(o, "trust", json_object_new_double(trust));
+  json_object_object_add(o, "score", json_object_new_double(u->score));
+  json_object_object_add(o, "ref", json_object_new_string(ref));
+  json_object_object_add(o, "collect_ms", json_object_new_int64(s->collect_us / 1000));
+  json_object_object_add(o, "rate_ul_kbps", json_object_new_double(s->rate_ul));
+  json_object_object_add(o, "rate_dl_kbps", json_object_new_double(s->rate_dl));
+  json_object_object_add(o, "thp_ul_kbps", json_object_new_double(s->thp_ul));
+  json_object_object_add(o, "thp_dl_kbps", json_object_new_double(s->thp_dl));
+  json_object_object_add(o, "prb_ul_pct", json_object_new_double(s->prb_ul));
+  json_object_object_add(o, "prb_dl_pct", json_object_new_double(s->prb_dl));
+  event(o);
+}
+
+static sqlite3_int64 save_action(const ue_t *u, int64_t now, int ratio, uint64_t amf, int code, json_object *res) {
+  sqlite3_int64 id = 0;
+  char at[40], detail[64];
+  iso(now, at, sizeof(at));
+  snprintf(detail, sizeof(detail), "max_prb_ratio=%d ue=%" PRIu64, ratio, amf);
+  if (db) {
+    sqlite3_stmt *q = NULL;
+    if (sqlite3_prepare_v2(db, "INSERT INTO actions(supi,at,layer,action,detail,status,verified) VALUES(?,?,'ran','prb_quota',?,?,0)", -1, &q, NULL) == SQLITE_OK) {
+      sqlite3_bind_text(q, 1, u->supi, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 2, at, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_text(q, 3, detail, -1, SQLITE_TRANSIENT);
+      sqlite3_bind_int(q, 4, code);
+      if (sqlite3_step(q) == SQLITE_DONE) id = sqlite3_last_insert_rowid(db);
+    }
+    sqlite3_finalize(q);
+  }
+  json_object *o = event_base("action", u, now);
+  json_object_object_add(o, "action", json_object_new_string("prb_quota"));
+  json_object_object_add(o, "max_prb_ratio", json_object_new_int(ratio));
+  json_object_object_add(o, "amf_ue_ngap_id", json_object_new_uint64(amf));
+  json_object_object_add(o, "http", json_object_new_int(code));
+  if (res) json_object_object_add(o, "result", json_object_get(res));
+  event(o);
+  return id;
+}
+
+static void open_db(const char *path) {
+  if (!path || sqlite3_open(path, &db) != SQLITE_OK) {
+    fprintf(stderr, "[defense] cannot open %s: reputation not persisted\n", path ? path : "(null)");
+    if (db) sqlite3_close(db);
+    db = NULL;
+    return;
+  }
+  exec_sql("PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;"
+           "CREATE TABLE IF NOT EXISTS reputation(supi TEXT PRIMARY KEY,level INTEGER NOT NULL,score REAL NOT NULL,"
+           "expires_at TEXT NOT NULL,updated_at TEXT NOT NULL);"
+           "CREATE TABLE IF NOT EXISTS evidence(id INTEGER PRIMARY KEY,supi TEXT NOT NULL,at TEXT NOT NULL,layer TEXT NOT NULL,"
+           "kind TEXT NOT NULL,severity REAL NOT NULL,ref TEXT NOT NULL,trust REAL NOT NULL);"
+           "CREATE TABLE IF NOT EXISTS actions(id INTEGER PRIMARY KEY,supi TEXT NOT NULL,at TEXT NOT NULL,layer TEXT NOT NULL,"
+           "action TEXT NOT NULL,detail TEXT NOT NULL,status INTEGER NOT NULL,verified INTEGER NOT NULL);"
+           "CREATE TABLE IF NOT EXISTS e2_trust(e2_node TEXT PRIMARY KEY,kpm_trust REAL NOT NULL DEFAULT 1.0,"
+           "ctrl_trust REAL NOT NULL DEFAULT 1.0,last_mismatch TEXT,alarm INTEGER NOT NULL DEFAULT 0);");
+}
+
+/* KPM trust of an E2 node (design 5.5; updated by the consistency check in
+   Phase L, 1.0 until then) */
+static double kpm_trust(const char *node) {
+  double t = 1.0;
+  if (!db) return t;
+  sqlite3_stmt *q = NULL;
+  if (sqlite3_prepare_v2(db, "INSERT OR IGNORE INTO e2_trust(e2_node) VALUES(?)", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, node, -1, SQLITE_TRANSIENT);
+    sqlite3_step(q);
+  }
+  sqlite3_finalize(q);
+  if (sqlite3_prepare_v2(db, "SELECT kpm_trust FROM e2_trust WHERE e2_node=?", -1, &q, NULL) == SQLITE_OK) {
+    sqlite3_bind_text(q, 1, node, -1, SQLITE_TRANSIENT);
+    if (sqlite3_step(q) == SQLITE_ROW) t = sqlite3_column_double(q, 0);
+  }
+  sqlite3_finalize(q);
+  return t;
+}
+
+/* ---------- state machine ---------- */
+
+static ue_t *ue_for(const char *supi, bool create) {
+  ue_t *free_slot = NULL;
+  for (int i = 0; i < MAX_UES; i++) {
+    if (ues[i].used && strcmp(ues[i].supi, supi) == 0) return &ues[i];
+    if (!ues[i].used && !free_slot) free_slot = &ues[i];
+  }
+  if (!create || !free_slot) return NULL;
+  memset(free_slot, 0, sizeof(*free_slot));
+  free_slot->used = true;
+  snprintf(free_slot->supi, sizeof(free_slot->supi), "%s", supi);
+  return free_slot;
+}
+
+static int popcount_n(uint32_t bits, int n) {
+  return __builtin_popcount(n >= 32 ? bits : (bits & ((1u << n) - 1)));
+}
+
+static void add_score(ue_t *u, int64_t now, double v) {
+  if (u->score_us && cfg.half_life_s > 0) u->score *= pow(0.5, (now - u->score_us) / 1e6 / cfg.half_life_s);
+  u->score += v;
+  u->score_us = now;
+}
+
+static void set_level(ue_t *u, int level, int64_t now, const char *why) {
+  int old = u->level;
+  u->level = level;
+  u->expires_us = level > 0 ? now + (int64_t)cfg.expiry_s[level > 2 ? 1 : level - 1] * 1000000 : 0;
+  save_reputation(u, now);
+  if (old != level) {
+    json_object *o = event_base("level", u, now);
+    json_object_object_add(o, "from", json_object_new_int(old));
+    json_object_object_add(o, "why", json_object_new_string(why));
+    event(o);
+    printf("[defense] %s level %d -> %d (%s)\n", u->supi, old, level, why);
+    fflush(stdout);
+  }
+}
+
+static void process(const sample_t *s, int64_t now) {
+  char supi[96] = "";
+  if (!urr_receiver_supi_for_ue(s->amf, supi, sizeof(supi))) {
+    unlabelled++;
+    return;
+  }
+  ue_t *u = ue_for(supi, true);
+  if (!u) return;
+  u->amf = s->amf;
+  u->last_seen_us = now;
+  if (!cfg.enabled) return;
+
+  const char *kind = NULL;
+  if (cfg.ul_rate_kbps > 0 && s->rate_ul >= cfg.ul_rate_kbps) kind = "kpm_rate_ul";
+  else if (cfg.dl_rate_kbps > 0 && s->rate_dl >= cfg.dl_rate_kbps) kind = "kpm_rate_dl";
+  else if (cfg.ul_prb_pct > 0 && s->prb_ul >= cfg.ul_prb_pct) kind = "kpm_prb_ul";
+  else if (cfg.dl_prb_pct > 0 && s->prb_dl >= cfg.dl_prb_pct) kind = "kpm_prb_dl";
+  u->over_bits = (u->over_bits << 1) | (kind != NULL);
+  if (kind && popcount_n(u->over_bits, cfg.n) >= cfg.k) {
+    double trust = kpm_trust(s->node);
+    add_score(u, now, cfg.sev_rate * trust);
+    save_evidence(u, now, kind, cfg.sev_rate, trust, s);
+    u->over_bits = 0;
+    set_level(u, u->level > 1 ? u->level : 1, now, kind);
+  }
+
+  /* quota in force for this UE ID: verified when the PRB share obeys it,
+     "full" when the UE keeps it saturated (confirmation, level 2) */
+  if (u->applied_ratio > 0 && u->synced_amf == s->amf) {
+    if (!u->verified && s->prb_ul <= u->applied_ratio + 3 && s->prb_dl <= u->applied_ratio + 3) {
+      u->verified = true;
+      if (db && u->last_action) {
+        char sql[96];
+        snprintf(sql, sizeof(sql), "UPDATE actions SET verified=1 WHERE id=%lld", (long long)u->last_action);
+        exec_sql(sql);
+      }
+      json_object *o = event_base("verified", u, now);
+      json_object_object_add(o, "collect_ms", json_object_new_int64(s->collect_us / 1000));
+      json_object_object_add(o, "prb_ul_pct", json_object_new_double(s->prb_ul));
+      json_object_object_add(o, "prb_dl_pct", json_object_new_double(s->prb_dl));
+      event(o);
+    }
+    bool full = s->prb_ul >= u->applied_ratio - cfg.margin_pct || s->prb_dl >= u->applied_ratio - cfg.margin_pct;
+    u->sat_bits = (u->sat_bits << 1) | full;
+    if (full && u->level >= 1 && popcount_n(u->sat_bits, cfg.confirm_n) >= cfg.confirm_k) {
+      double trust = kpm_trust(s->node);
+      add_score(u, now, cfg.sev_saturated * trust);
+      save_evidence(u, now, "kpm_quota_full", cfg.sev_saturated, trust, s);
+      u->sat_bits = 0;
+      /* RAN evidence alone stops at level 2 (design 6) */
+      set_level(u, u->level < 2 ? 2 : u->level, now, "kpm_quota_full");
+    }
+  }
+}
+
+static void expire(int64_t now) {
+  for (int i = 0; i < MAX_UES; i++) {
+    ue_t *u = &ues[i];
+    if (u->used && u->level > 0 && now >= u->expires_us) set_level(u, u->level - 1, now, "expired");
+  }
+}
+
+/* Bring the gNB in line with the levels: quota while level >= 1, on the UE
+   ID the SUPI currently has (a re-attach gets it again) */
+static void reconcile(int64_t now) {
+  for (int i = 0; i < MAX_UES; i++) {
+    pthread_mutex_lock(&st_lock);
+    ue_t *u = &ues[i];
+    if (!u->used || now < u->next_try_us) {
+      pthread_mutex_unlock(&st_lock);
+      continue;
+    }
+    bool present = u->amf && now - u->last_seen_us <= UE_GONE_US;
+    int want = u->level >= 1 && cfg.enabled ? cfg.max_prb_ratio : 0;
+    /* set the quota explicitly once per UE ID: a quota left by an earlier
+       xApp instance is unknown to this one */
+    bool needed = present && (u->synced_amf != u->amf || u->applied_ratio != want);
+    if (!needed) {
+      pthread_mutex_unlock(&st_lock);
+      continue;
+    }
+    char supi[96];
+    snprintf(supi, sizeof(supi), "%s", u->supi);
+    uint64_t amf = u->amf;
+    pthread_mutex_unlock(&st_lock);
+
+    json_object *res = NULL;
+    int code = ran_control_apply(supi, amf, true, "prb_quota", want ? want : 100, "defense", &res);
+
+    pthread_mutex_lock(&st_lock);
+    if (u->used && strcmp(u->supi, supi) == 0) {
+      if (code == 200) {
+        u->applied_ratio = want;
+        u->synced_amf = amf;
+        u->verified = false;
+        u->sat_bits = 0;
+      } else {
+        u->next_try_us = now + RETRY_US;
+      }
+      sqlite3_int64 id = save_action(u, now, want ? want : 100, amf, code, res);
+      if (want) u->last_action = id;
+    }
+    pthread_mutex_unlock(&st_lock);
+    json_object_put(res);
+  }
+}
+
+static void *run(void *arg) {
+  (void)arg;
+  sample_t local[QUEUE_LEN];
+  for (;;) {
+    pthread_mutex_lock(&q_lock);
+    if (q_len == 0 && running) {
+      struct timespec ts;
+      clock_gettime(CLOCK_REALTIME, &ts);
+      ts.tv_sec += 1;
+      pthread_cond_timedwait(&q_cond, &q_lock, &ts);
+    }
+    if (!running) {
+      pthread_mutex_unlock(&q_lock);
+      return NULL;
+    }
+    size_t n = q_len;
+    for (size_t i = 0; i < n; i++) local[i] = queue[(q_head + i) % QUEUE_LEN];
+    q_head = (q_head + n) % QUEUE_LEN;
+    q_len = 0;
+    pthread_mutex_unlock(&q_lock);
+
+    int64_t now = time_now_us();
+    pthread_mutex_lock(&st_lock);
+    for (size_t i = 0; i < n; i++) process(&local[i], now);
+    expire(now);
+    pthread_mutex_unlock(&st_lock);
+    reconcile(now);
+  }
+}
+
+/* ---------- KPM input ---------- */
+
+static bool name_is(byte_array_t ba, const char *s) {
+  return ba.len == strlen(s) && memcmp(ba.buf, s, ba.len) == 0;
+}
+
+void defense_on_kpm(ue_id_e2sm_t const *ue_id, kpm_ind_msg_format_1_t const *msg, int64_t collect_us, const char *e2_node) {
+  if (!running || !ue_id || ue_id->type != GNB_UE_ID_E2SM || !msg || msg->meas_data_lst_len == 0) return;
+  sample_t s = {.amf = ue_id->gnb.amf_ue_ngap_id, .collect_us = collect_us};
+  snprintf(s.node, sizeof(s.node), "%s", e2_node ? e2_node : "?");
+  const meas_data_lst_t *data = &msg->meas_data_lst[0];
+  const double period_s = msg->gran_period_ms && *msg->gran_period_ms ? *msg->gran_period_ms / 1000.0 : 1.0;
+  size_t rec = 0;
+  for (size_t i = 0; i < msg->meas_info_lst_len; i++) {
+    const meas_info_format_1_lst_t *info = &msg->meas_info_lst[i];
+    for (size_t z = 0; z < info->label_info_lst_len; z++, rec++) {
+      if (rec >= data->meas_record_len || info->meas_type.type != NAME_MEAS_TYPE || z > 0) continue;
+      const meas_record_lst_t *r = &data->meas_record_lst[rec];
+      double v = r->value == INTEGER_MEAS_VALUE ? r->int_val : r->value == REAL_MEAS_VALUE ? r->real_val : 0;
+      if (name_is(info->meas_type.name, "DRB.PdcpSduVolumeUL")) s.rate_ul = v * 1000.0 / period_s; /* Mb -> kbit/s */
+      else if (name_is(info->meas_type.name, "DRB.PdcpSduVolumeDL")) s.rate_dl = v * 1000.0 / period_s;
+      else if (name_is(info->meas_type.name, "DRB.UEThpUl")) s.thp_ul = v;
+      else if (name_is(info->meas_type.name, "DRB.UEThpDl")) s.thp_dl = v;
+      else if (name_is(info->meas_type.name, "RRU.PrbTotUl")) s.prb_ul = v;
+      else if (name_is(info->meas_type.name, "RRU.PrbTotDl")) s.prb_dl = v;
+    }
+  }
+  pthread_mutex_lock(&q_lock);
+  if (q_len == QUEUE_LEN) {
+    dropped++;
+  } else {
+    queue[(q_head + q_len++) % QUEUE_LEN] = s;
+    pthread_cond_signal(&q_cond);
+  }
+  pthread_mutex_unlock(&q_lock);
+}
+
+/* ---------- HTTP ---------- */
+
+int defense_http(const char *url, const char *body, struct json_object **out) {
+  json_object *o = json_object_new_object();
+  *out = o;
+  if (strcmp(url, "/v1/defense/state") == 0 && !body) {
+    pthread_mutex_lock(&st_lock);
+    json_object_object_add(o, "enabled", json_object_new_boolean(cfg.enabled));
+    json_object_object_add(o, "profile", json_object_new_string(cfg.profile));
+    json_object_object_add(o, "max_prb_ratio", json_object_new_int(cfg.max_prb_ratio));
+    json_object_object_add(o, "unlabelled_samples", json_object_new_uint64(unlabelled));
+    json_object_object_add(o, "dropped_samples", json_object_new_uint64(dropped));
+    json_object *arr = json_object_new_array();
+    int64_t now = time_now_us();
+    for (int i = 0; i < MAX_UES; i++) {
+      ue_t *u = &ues[i];
+      if (!u->used) continue;
+      json_object *e = json_object_new_object();
+      json_object_object_add(e, "supi", json_object_new_string(u->supi));
+      json_object_object_add(e, "level", json_object_new_int(u->level));
+      json_object_object_add(e, "score", json_object_new_double(u->score));
+      json_object_object_add(e, "expires_in_s", json_object_new_double(u->level ? (u->expires_us - now) / 1e6 : 0));
+      json_object_object_add(e, "amf_ue_ngap_id", json_object_new_uint64(u->amf));
+      json_object_object_add(e, "applied_ratio", json_object_new_int(u->applied_ratio));
+      json_object_object_add(e, "synced_amf_ue_ngap_id", json_object_new_uint64(u->synced_amf));
+      json_object_object_add(e, "verified", json_object_new_boolean(u->verified));
+      json_object_array_add(arr, e);
+    }
+    pthread_mutex_unlock(&st_lock);
+    json_object_object_add(o, "ues", arr);
+    return 200;
+  }
+  json_object *in = body ? json_tokener_parse(body) : NULL, *x = NULL;
+  int code = 404;
+  if (strcmp(url, "/v1/defense/enabled") == 0 && in && json_object_object_get_ex(in, "enabled", &x) && json_object_is_type(x, json_type_boolean)) {
+    pthread_mutex_lock(&st_lock);
+    cfg.enabled = json_object_get_boolean(x);
+    pthread_mutex_unlock(&st_lock);
+    json_object_object_add(o, "enabled", json_object_new_boolean(cfg.enabled));
+    printf("[defense] detection %s by request\n", cfg.enabled ? "enabled" : "disabled");
+    code = 200;
+  } else if (strcmp(url, "/v1/defense/reset") == 0 && in && json_object_object_get_ex(in, "supi", &x) && json_object_is_type(x, json_type_string)) {
+    pthread_mutex_lock(&st_lock);
+    ue_t *u = ue_for(json_object_get_string(x), false);
+    if (u) {
+      u->score = 0;
+      u->over_bits = u->sat_bits = 0;
+      set_level(u, 0, time_now_us(), "admin reset");
+      code = 200;
+    }
+    pthread_mutex_unlock(&st_lock);
+    json_object_object_add(o, "reset", json_object_new_boolean(code == 200));
+  } else {
+    json_object_object_add(o, "error", json_object_new_string("GET /v1/defense/state, POST /v1/defense/enabled|reset"));
+    code = body ? 400 : 404;
+  }
+  if (in) json_object_put(in);
+  return code;
+}
+
+/* ---------- lifecycle ---------- */
+
+int defense_start(const char *db_path, const char *event_log_path) {
+  load_config();
+  open_db(db_path);
+  if (event_log_path && !(events = fopen(event_log_path, "a")))
+    fprintf(stderr, "[defense] cannot open %s\n", event_log_path);
+  /* reputation survives an xApp restart: levels still in force come back
+     and their quotas are applied again when the SUPI is next seen */
+  if (db) {
+    sqlite3_stmt *q = NULL;
+    char now_iso[40];
+    iso(time_now_us(), now_iso, sizeof(now_iso));
+    if (sqlite3_prepare_v2(db, "SELECT supi,level,score,expires_at FROM reputation WHERE level>0 AND expires_at>?", -1, &q, NULL) == SQLITE_OK) {
+      sqlite3_bind_text(q, 1, now_iso, -1, SQLITE_TRANSIENT);
+      while (sqlite3_step(q) == SQLITE_ROW) {
+        ue_t *u = ue_for((const char *)sqlite3_column_text(q, 0), true);
+        if (!u) break;
+        u->level = sqlite3_column_int(q, 1);
+        u->score = sqlite3_column_double(q, 2);
+        u->score_us = time_now_us();
+        struct tm tm = {0};
+        if (strptime((const char *)sqlite3_column_text(q, 3), "%Y-%m-%dT%H:%M:%S", &tm))
+          u->expires_us = (int64_t)timegm(&tm) * 1000000;
+        printf("[defense] restored %s at level %d\n", u->supi, u->level);
+      }
+    }
+    sqlite3_finalize(q);
+  }
+  running = true;
+  return pthread_create(&worker, NULL, run, NULL) == 0 ? 0 : -1;
+}
+
+void defense_stop(void) {
+  pthread_mutex_lock(&q_lock);
+  bool was = running;
+  running = false;
+  pthread_cond_signal(&q_cond);
+  pthread_mutex_unlock(&q_lock);
+  if (was) pthread_join(worker, NULL);
+  if (events) fclose(events);
+  events = NULL;
+  if (db) sqlite3_close(db);
+  db = NULL;
+}
