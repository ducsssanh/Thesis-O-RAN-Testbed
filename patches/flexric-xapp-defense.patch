+#define MAX_UES 64
+#define QUEUE_LEN 256
+#define RETRY_US 2000000LL
+#define UE_GONE_US 10000000LL
+
+typedef struct {
+  bool enabled;
+  char profile[16];
+  /* mean rate over the KPM period from DRB.PdcpSduVolume (DRB.UEThp is the
+     rate while data is buffered, TS 28.552: a 2 Mbit/s UE reads 3.6 Mbit/s
+     next to a flood); 0 disables a rule */
+  double ul_rate_kbps, dl_rate_kbps, ul_prb_pct, dl_prb_pct;
+  int k, n;                   /* detector: k of the last n samples */
+  int max_prb_ratio;          /* RAN action of levels 1-2 */
+  double margin_pct;          /* quota "full": PRB share >= ratio - margin */
+  int confirm_k, confirm_n;
+  int expiry_s[2];            /* levels 1, 2 of the active profile */
+  double sev_rate, sev_saturated, half_life_s;
+} config_t;
+
+typedef struct {
+  uint64_t amf;
+  int64_t collect_us;
+  double rate_ul, rate_dl, thp_ul, thp_dl, prb_ul, prb_dl;
+  char node[32];
+} sample_t;
+
+typedef struct {
+  bool used;
+  char supi[96];
+  int level;
+  double score;
+  int64_t score_us, expires_us, last_seen_us, next_try_us;
+  uint32_t over_bits, sat_bits;
+  uint64_t amf;               /* UE ID of the latest KPM report */
+  int applied_ratio;          /* quota in force at the gNB for synced_amf (0 none) */
+  uint64_t synced_amf;        /* UE ID whose gNB quota this xApp has set (0: unknown,
+                                 e.g. after an xApp restart) */
+  sqlite3_int64 last_action;  /* row of the latest quota action */
+  bool verified;
+} ue_t;
+
+static config_t cfg;
+static ue_t ues[MAX_UES];
+static sample_t queue[QUEUE_LEN];
+static size_t q_head, q_len;
+static unsigned long long dropped, unlabelled;
+static pthread_mutex_t q_lock = PTHREAD_MUTEX_INITIALIZER, st_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t q_cond = PTHREAD_COND_INITIALIZER;
+static pthread_t worker;
