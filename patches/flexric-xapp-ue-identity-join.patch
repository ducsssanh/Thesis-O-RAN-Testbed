+static void remember_identity(const urr_record_t *r){
+  if(!r->has_ran_identity || !r->supi[0])return;
+  size_t slot=identity_count;
+  for(size_t i=0;i<identity_count;i++){
+    if(strcmp(identities[i].supi,r->supi)==0)slot=i;
+    else if(identities[i].amf_ue_ngap_id==r->amf_ue_ngap_id)identities[i].supi[0]='\0'; /* ID reused by AMF */
+  }
+  if(slot==identity_count){if(identity_count==MAX_UE_IDENTITIES)return;identity_count++;}
+  identities[slot].amf_ue_ngap_id=r->amf_ue_ngap_id;
+  snprintf(identities[slot].supi,sizeof(identities[slot].supi),"%s",r->supi);
+}
 
