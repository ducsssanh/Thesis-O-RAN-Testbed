+/* \brief largest allocation for a new transmission of this UE, from the
+ * E2SM-RC PRB quota (percent of the BWP, at least min_rbs) */
+int nr_mac_ue_max_rbs(const NR_UE_sched_ctrl_t *sched_ctrl, int bwp_size, int min_rbs)
+{
+  const int ratio = sched_ctrl->e2_max_prb_ratio;
+  if (ratio == 0 || ratio >= 100)
+    return bwp_size;
+  return min(bwp_size, max(min_rbs, (bwp_size * ratio + 50) / 100));
+}
