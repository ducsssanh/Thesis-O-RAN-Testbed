+// One CONTROL style with one action, header/message/outcome format 1
+static seq_ctrl_act_2_t* fill_rc_ctrl_style(seq_ctrl_style_t* ctrl_style, uint32_t style, const char* style_name, uint16_t act_id, const char* act_name)
+{
+  ctrl_style->style_type = style;
+  ctrl_style->name = cp_str_to_ba(style_name);
+  ctrl_style->hdr = FORMAT_1_E2SM_RC_CTRL_HDR;
+  ctrl_style->msg = FORMAT_1_E2SM_RC_CTRL_MSG;
+  ctrl_style->call_proc_id_type = NULL;
+  ctrl_style->out_frmt = FORMAT_1_E2SM_RC_CTRL_OUT;
+  ctrl_style->sz_seq_ctrl_act = 1;
+  ctrl_style->seq_ctrl_act = calloc(1, sizeof(seq_ctrl_act_2_t));
+  assert(ctrl_style->seq_ctrl_act != NULL && "Memory exhausted");
+  ctrl_style->seq_ctrl_act[0].id = act_id;
+  ctrl_style->seq_ctrl_act[0].name = cp_str_to_ba(act_name);
+  ctrl_style->sz_ran_param_ctrl_out = 0;
+  ctrl_style->ran_param_ctrl_out = NULL;
+  return &ctrl_style->seq_ctrl_act[0];
+}
+
+// E2SM-RC 8.4.3.6 Slice-level PRB quota: the top-level RAN Parameter and the
+// three ratios inside each RRM Policy Ratio Group
+static void fill_prb_quota_params(seq_ctrl_act_2_t* act)
+{
+  static const struct {
+    uint32_t id;
+    const char* name;
+  } params[] = {
+      {RC_PRB_QUOTA_POLICY_RATIO_LIST, "RRM Policy Ratio List"},
+      {RC_PRB_QUOTA_MIN_RATIO, "Min PRB Policy Ratio"},
+      {RC_PRB_QUOTA_MAX_RATIO, "Max PRB Policy Ratio"},
+      {RC_PRB_QUOTA_DEDICATED_RATIO, "Dedicated PRB Policy Ratio"},
+  };
+  act->sz_seq_assoc_ran_param = sizeof(params) / sizeof(params[0]);
+  act->assoc_ran_param = calloc(act->sz_seq_assoc_ran_param, sizeof(seq_ran_param_3_t));
+  assert(act->assoc_ran_param != NULL && "Memory exhausted");
+  for (size_t i = 0; i < act->sz_seq_assoc_ran_param; i++) {
+    act->assoc_ran_param[i].id = params[i].id;
+    act->assoc_ran_param[i].name = cp_str_to_ba(params[i].name);
+    act->assoc_ran_param[i].def = NULL;
+  }
+}
+
+// with_ue_actions: the E2 node runs the MAC scheduler and the RRC (monolithic
+// gNB), so it also offers the per-UE PRB quota and the RRC release
+static void fill_rc_control(ran_func_def_ctrl_t* ctrl, bool with_ue_actions)
+{
+  // Sequence of CONTROL styles
+  // [1 - 63]
+  ctrl->sz_seq_ctrl_style = with_ue_actions ? 3 : 1;
+  ctrl->seq_ctrl_style = calloc(ctrl->sz_seq_ctrl_style, sizeof(seq_ctrl_style_t));
+  assert(ctrl->seq_ctrl_style != NULL && "Memory exhausted");
+
+  fill_rc_ctrl_style_1(&ctrl->seq_ctrl_style[0]);
+  if (!with_ue_actions)
+    return;
+
+  seq_ctrl_act_2_t* quota = fill_rc_ctrl_style(&ctrl->seq_ctrl_style[1],
+                                               RC_CTRL_STYLE_RADIO_RESOURCE_ALLOCATION,
+                                               "Radio Resource Allocation Control",
+                                               RC_CTRL_ACT_SLICE_PRB_QUOTA,
+                                               "Slice-level PRB quota");
+  fill_prb_quota_params(quota);
+  fill_rc_ctrl_style(&ctrl->seq_ctrl_style[2], RC_CTRL_STYLE_RADIO_ACCESS, "Radio Access Control", RC_CTRL_ACT_RRC_RELEASE, "RRC Connection Release");
+}
