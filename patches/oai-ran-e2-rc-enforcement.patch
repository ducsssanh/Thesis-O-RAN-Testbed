+#if RC_UE_ACTIONS
+// Value of the first RAN Parameter with this ID, at any depth (inside
+// STRUCTURE parameters and LIST items)
+static const ran_parameter_value_t* find_ran_param_value(const seq_ran_param_t* p, size_t n, uint32_t id)
+{
+  for (size_t i = 0; i < n; i++) {
+    const ran_param_val_type_t* v = &p[i].ran_param_val;
+    if (p[i].ran_param_id == id && v->type == ELEMENT_KEY_FLAG_TRUE_RAN_PARAMETER_VAL_TYPE)
+      return v->flag_true;
+    if (p[i].ran_param_id == id && v->type == ELEMENT_KEY_FLAG_FALSE_RAN_PARAMETER_VAL_TYPE)
+      return v->flag_false;
+    const ran_parameter_value_t* found = NULL;
+    if (v->type == STRUCTURE_RAN_PARAMETER_VAL_TYPE && v->strct != NULL)
+      found = find_ran_param_value(v->strct->ran_param_struct, v->strct->sz_ran_param_struct, id);
+    if (v->type == LIST_RAN_PARAMETER_VAL_TYPE && v->lst != NULL) {
+      for (size_t j = 0; j < v->lst->sz_lst_ran_param && found == NULL; j++) {
+        const ran_param_struct_t* item = &v->lst->lst_ran_param[j].ran_param_struct;
+        found = find_ran_param_value(item->ran_param_struct, item->sz_ran_param_struct, id);
+      }
+    }
+    if (found != NULL)
+      return found;
+  }
+  return NULL;
+}
