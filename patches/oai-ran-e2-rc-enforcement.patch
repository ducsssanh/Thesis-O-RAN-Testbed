+// MAC UE with this E2SM gNB UE ID (AMF UE NGAP ID + GUAMI, as in the KPM
+// reports). Call with the scheduler lock held.
+static NR_UE_info_t* find_mac_ue(const ue_id_e2sm_t* ue_id)
+{
+  if (ue_id->type != GNB_UE_ID_E2SM)
+    return NULL;
+  const guami_t* guami = &ue_id->gnb.guami;
+  UE_iterator (RC.nrmac[0]->UE_info.connected_ue_list, ue) {
+    rrc_gNB_ue_context_t* rrc_ue = rrc_gNB_get_ue_context_by_rnti(RC.nrrrc[0], -1, ue->rnti);
+    if (rrc_ue == NULL)
+      continue;
+    const gNB_RRC_UE_t* u = &rrc_ue->ue_context;
+    if (u->amf_ue_ngap_id == ue_id->gnb.amf_ue_ngap_id && u->ue_guami.amf_region_id == guami->amf_region_id
+        && u->ue_guami.amf_set_id == guami->amf_set_id && u->ue_guami.amf_pointer == guami->amf_ptr)
+      return ue;
+  }
+  return NULL;
+}
+
+// Style 2, Slice-level PRB quota. OAI's MAC has no slices, so the quota is
+// applied to the UE named in the header: its Max PRB Policy Ratio (percent of
+// the BWP) bounds every new DL and UL allocation; 100 removes the quota.
+static void ctrl_prb_quota(const rc_ctrl_req_data_t* ctrl)
+{
+  const e2sm_rc_ctrl_msg_frmt_1_t* msg = &ctrl->msg.frmt_1;
+  const ran_parameter_value_t* max_ratio = find_ran_param_value(msg->ran_param, msg->sz_ran_param, RC_PRB_QUOTA_MAX_RATIO);
+  if (max_ratio == NULL || max_ratio->type != INTEGER_RAN_PARAMETER_VALUE || max_ratio->int_ran < 0 || max_ratio->int_ran > 100) {
+    printf("[E2 AGENT] RC CONTROL PRB quota: no valid Max PRB Policy Ratio (0..100), ignored\n");
+    return;
+  }
+  const int ratio = max_ratio->int_ran;
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  NR_UE_info_t* ue = find_mac_ue(&ctrl->hdr.frmt_1.ue_id);
+  int rnti = -1;
+  if (ue != NULL) {
+    ue->UE_sched_ctrl.e2_max_prb_ratio = ratio >= 100 ? 0 : max(1, ratio);
+    rnti = ue->rnti;
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (rnti < 0)
+    printf("[E2 AGENT] RC CONTROL PRB quota: no UE with AMF UE NGAP ID %lu, ignored\n", ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id);
+  else
+    printf("[E2 AGENT] RC CONTROL PRB quota: UE %04x (AMF UE NGAP ID %lu) Max PRB Policy Ratio %d%%\n",
+           rnti,
+           ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id,
+           ratio);
+}
+
+// Style 4, RRC Connection Release: the same request the DU makes after a
+// radio link failure (F1 UE Context Release Request), so the CU asks the AMF
+// (NGAP UE Context Release Request) and releases the UE with RRCRelease
+static void ctrl_rrc_release(const rc_ctrl_req_data_t* ctrl)
+{
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  NR_UE_info_t* ue = find_mac_ue(&ctrl->hdr.frmt_1.ue_id);
+  const int rnti = ue != NULL ? ue->rnti : -1;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (rnti < 0) {
+    printf("[E2 AGENT] RC CONTROL RRC release: no UE with AMF UE NGAP ID %lu, ignored\n", ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id);
+    return;
+  }
+  const bool requested = nr_mac_request_release_ue(mac, rnti);
+  printf("[E2 AGENT] RC CONTROL RRC release: UE %04x (AMF UE NGAP ID %lu) %s\n",
+         rnti,
+         ctrl->hdr.frmt_1.ue_id.gnb.amf_ue_ngap_id,
+         requested ? "release requested" : "unknown to the CU, not released");
+}
