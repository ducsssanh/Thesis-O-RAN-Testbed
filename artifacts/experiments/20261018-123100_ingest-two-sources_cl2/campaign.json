 "scenario": {
  "name": "ingest-two-sources",
  "description": "Data path check (~7 min): the xApp receives KPM (gNB, E2) and URR (eBPF\nUPF, PFCP -> SMF -> producer -> A1-EI -> adapter) for each SUPI, every\nsecond, complete and bound to the right UE, through an idle period, UL and\nDL traffic, swapped rates and a UE re-attach. Detection off (no action\nshapes the traffic); the xApp still builds the feature vectors. The two\nUEs send 4x apart so a swapped SUPI binding shows as a ~4x volume error.\nGrade: python3 scripts/k8s/exp/ingest_check.py <campaign dir>\n",
  "ues": {
   "ue1": "benign",
   "ue2": "benign"
  },
  "reps": 1,
  "payload_bytes": 1200,
  "drain": {
   "quiet_kbps": 300,
   "timeout_s": 300
  },
  "tail_s": 12,
  "variants": [
   {
    "name": "detection-off",
    "defense": {
     "enabled": false,
     "core": false
    }
   }
  ],
  "phases": [
   {
    "name": "idle",
    "duration": 30
   },
   {
    "name": "ul-4x",
    "duration": 60,
    "baseline": true,
    "flows": {
     "ue1": {
      "ul": "3M"
     },
     "ue2": {
      "ul": "750k"
     }
    }
   },
   {
    "name": "dl-4x",
    "duration": 60,
    "flows": {
     "ue1": {
      "dl": "6M"
     },
     "ue2": {
      "dl": "1500k"
     }
    }
   },
   {
    "name": "ul-swapped",
    "duration": 40,
    "flows": {
     "ue1": {
      "ul": "750k"
     },
     "ue2": {
      "ul": "3M"
     }
    }
   },
   {
    "name": "reconnect",
    "duration": 60,
    "action": {
     "restart_ue": "ue2",
     "restart_xapp": true
    },
    "flows": {
     "ue1": {
      "ul": "750k"
     },
     "ue2": {
      "ul": "2M"
     }
    }
   }
  ],
  "report": [
   "benign_max_level",
   "benign_delivered_ratio_baseline"
  ]
 },
