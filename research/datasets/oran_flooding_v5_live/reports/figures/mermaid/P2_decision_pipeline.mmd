%% Paper Fig. 2 — per-UE decision step (once per KPM report)
flowchart TD
  K["KPM row (RAN): UL rate, PRB"] --> F
  U["URR + profiler row (core), age a"] --> F
  F["Rolling features 1 s + 5/10/30 s<br/>(mean, std, slope, max)"] --> M
  M["3 GBDT scores z = p / threshold<br/>z_ran, z_core, z_xd"] --> FU
  K --> IC
  U --> IC
  IC{"KPM↔URR integrity:<br/>ΣKPM and ΣURR differ more than 2x<br/>for 10 s?"}
  IC -- yes --> KT["KPM trust kt = 0 (60 s), then ramp 30 s<br/>flag E2 node"]
  IC -- no --> KT1["kt unchanged"]
  U --> CT{"core data older than 4 s?"}
  CT -- yes --> CT0["core trust ct = 0"]
  CT -- no --> CT1["ct = 1"]
  KT --> FU
  KT1 --> FU
  CT0 --> FU
  CT1 --> FU
  FU["Fusion z = kt·ct·z_xd + (1−kt)·ct·z_core + kt·(1−ct)·z_ran<br/>KPM below URR (hiding) adds evidence;<br/>KPM above URR (framing) only flags the E2 node"]
  FU --> L1{"alarm in 3 of last 5 s?"}
  L1 -- yes --> ISO["Isolate: quarantine slice + UPF monitor"]
  ISO --> L3{"isolated ≥ 10 s AND<br/>core alarm in 3 of 5 s?"}
  L3 -- yes --> BLK["Block at the UPF (TTL 120 s)"]
  L3 -- no --> ISO
  L1 -- no --> NONE["No action (isolation expires after 3 s)"]
