%% Thesis — one 4-phase run (seconds from run start; readiness waits not drawn)
gantt
  title One live run (KPM hide scenario), seconds from run start
  dateFormat X
  axisFormat %s
  section Harness
  setup, defence config, drain        :a0, 0, 20
  idle with defence reset             :a1, 20, 35
  phase 0 - UE1 floods, UE1 KPM tampered :crit, p0, 35, 95
  gap 0 - reset level, tamper off     :g0, 95, 110
  phase 1 - UE2 floods, UE2 KPM tampered :crit, p1, 110, 170
  gap 1                               :g1, 170, 185
  phase 2 - UE1 floods                :crit, p2, 185, 245
  gap 2                               :g2, 245, 260
  phase 3 - UE2 floods                :crit, p3, 260, 320
  gap 3, tail, log collection         :g3, 320, 358
  section Checks
  readiness check before each phase   :r0, 34, 35
  integrity check, profiler assert, QA :q, 358, 384
