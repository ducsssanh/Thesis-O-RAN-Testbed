# Upstream source trees: rebuilt from pinned commits and patches/ by scripts/verify-oai-upstream.sh --into src
/src/oai-ran/
/src/oai-smf/
/src/oai-upf/
/src/flexric/
/src/5gdeploy/

# Build and tooling output
__pycache__/
*.pyc
node_modules/
build/
*.o
*.a
.venv/
/.venv-ml/

# Generated at run time: image locks, logs, raw experiment runs, trained models and scores
/artifacts/

# Local working notes
/docs/

# External datasets (Madrid LTE traces and others), too large to track
/data/

# Madrid per-second reductions (regenerate with research/twinning/madrid_reduce.py from data/external/madrid)
/research/twinning/*.parquet
/research/twinning/*.npz
/research/twinning/benign_profiles.json

# Datasets: only the datasheet, the campaign manifest and the window table of the main dataset are tracked
/research/datasets/*
!/research/datasets/oran_flooding_twin/
/research/datasets/oran_flooding_twin/rows.parquet
/research/datasets/oran_flooding_twin/rows.csv

# Analysis output of the training rounds (regenerate with scripts/ml)
/research/clf/
